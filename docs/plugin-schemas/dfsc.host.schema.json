{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DFSC host capability declaration v1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostApiVersion", "consumer", "capabilities"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 512 },
    "schemaVersion": { "const": 1 },
    "hostApiVersion": { "const": 1 },
    "consumer": {
      "type": "object", "additionalProperties": false, "required": ["kind", "server"],
      "properties": {
        "kind": { "const": "mcp-stdio" },
        "server": {
          "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "not": { "enum": ["constructor", "prototype", "__proto__"] }
        }
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["model.text", "model.video", "model.asr", "model.tts"] }
    }
  }
}
