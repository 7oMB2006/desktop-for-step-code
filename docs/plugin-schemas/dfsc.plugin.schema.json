{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DFSC plugin presentation v1",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "authors": { "$ref": "#/definitions/people" },
    "maintainers": { "$ref": "#/definitions/people" },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "categories": {
      "type": "array", "maxItems": 3, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    },
    "keywords": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[^\\u0000-\\u001f]+$" }
    },
    "documentation": { "$ref": "#/definitions/documentation" },
    "desktop": { "$ref": "#/definitions/desktop" },
    "requirements": { "$ref": "#/definitions/requirements" },
    "locales": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "zh": { "$ref": "#/definitions/locale" },
        "en": { "$ref": "#/definitions/locale" }
      }
    },
    "tutorials": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "required": ["title", "url", "creator", "kind"], "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/definitions/label" },
          "creator": { "$ref": "#/definitions/label" },
          "url": { "$ref": "#/definitions/https" },
          "kind": { "enum": ["author", "community"] }
        }
      }
    },
    "links": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "required": ["title", "url"], "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/definitions/label" },
          "url": { "$ref": "#/definitions/https" },
          "kind": { "type": "string", "maxLength": 48 }
        }
      }
    }
  },
  "definitions": {
    "requirements": {
      "type": "object", "additionalProperties": false,
      "description": "Author-declared compatibility and external dependencies, not detected installation state. This grants no permission and never installs software or runs probes.",
      "properties": {
        "dfsc": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$",
          "description": "A valid semver range, checked by the host."
        },
        "external": {
          "type": "array", "maxItems": 12,
          "description": "Omitted means not declared; an explicit empty array declares no additional external dependencies.",
          "items": {
            "type": "object", "required": ["name"], "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/definitions/label" },
              "description": {
                "type": "string", "minLength": 1, "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f]+$"
              },
              "url": { "$ref": "#/definitions/https" },
              "optional": { "type": "boolean" }
            }
          }
        }
      }
    },
    "desktop": {
      "type": "object", "required": ["title", "surface", "pages"], "additionalProperties": false,
      "description": "A data-only workspace for an installed, recorded plugin. This grants no runtime or filesystem permission.",
      "properties": {
        "title": { "$ref": "#/definitions/label" },
        "surface": { "enum": ["main-view", "side-panel", "window"] },
        "symbol": { "enum": ["plug", "bot", "book", "wrench", "sparkles"] },
        "icon": {
          "type": "object", "required": ["light"], "additionalProperties": false,
          "properties": {
            "light": { "$ref": "#/definitions/rasterPath" },
            "dark": { "$ref": "#/definitions/rasterPath" }
          }
        },
        "defaultPage": {
          "$ref": "#/definitions/desktopPageId",
          "description": "Must match one declared page ID; the host validates this relationship."
        },
        "pages": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "description": "Page IDs must be unique and documents must exist in the installed package; the host validates these constraints.",
          "items": {
            "type": "object", "required": ["id", "title", "document"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/desktopPageId" },
              "title": { "$ref": "#/definitions/label" },
              "document": { "$ref": "#/definitions/markdownPath" }
            }
          }
        }
      }
    },
    "desktopPageId": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "rasterPath": {
      "type": "string", "minLength": 5, "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\\\u0000-\\u001f?#])(?!.*//).+\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP]|[iI][cC][oO])$"
    },
    "documentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "readme": { "$ref": "#/definitions/markdownPath" },
        "changelog": { "$ref": "#/definitions/markdownPath" }
      }
    },
    "locale": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u001f]+$" },
        "documentation": { "$ref": "#/definitions/documentation" }
      }
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f]+$" },
    "https": { "type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://[^/@?#]+(?:[/?#]|$)" },
    "markdownPath": {
      "type": "string", "minLength": 4, "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\\\u0000?#])(?!.*//).+\\.[mM][dD]$"
    },
    "people": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "required": ["name"], "additionalProperties": false,
        "properties": { "name": { "$ref": "#/definitions/label" } }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "documentation": { "readme": "README.md" },
      "requirements": { "dfsc": ">=0.6.0 <1.0.0", "external": [] },
      "desktop": {
        "title": "Engineering Bridge",
        "surface": "main-view",
        "symbol": "bot",
        "icon": { "light": "assets/bridge-light.png", "dark": "assets/bridge-dark.png" },
        "defaultPage": "start",
        "pages": [
          { "id": "start", "title": "Get started", "document": "docs/start.md" },
          { "id": "connections", "title": "Connections", "document": "docs/connections.md" }
        ]
      }
    }
  ]
}
