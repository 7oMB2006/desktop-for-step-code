{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DFSC theme composition",
  "description": "Authoring schema only. The host also validates resources, geometry, decoded images and text contrast.",
  "oneOf": [
    { "$ref": "#/definitions/version1" },
    { "$ref": "#/definitions/version2" }
  ],
  "definitions": {
    "common": {
      "type": "object",
      "required": ["schemaVersion", "name", "scheme", "colors"],
      "properties": {
        "$schema": {},
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
        },
        "author": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "cover": { "const": "cover.png" },
        "scheme": { "enum": ["light", "dark"] },
        "colors": { "$ref": "#/definitions/colors" }
      }
    },
    "version1": {
      "allOf": [{ "$ref": "#/definitions/common" }],
      "required": ["renderer", "scene"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scheme": { "const": "dark" },
        "renderer": { "const": "stellar-v1" },
        "scene": { "const": "scene.json" }
      },
      "description": "Legacy Stellar composition. Extra declarations do not opt it into background replacement."
    },
    "version2": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "if": {
            "required": ["ui"],
            "properties": {
              "ui": {
                "required": ["renderer"],
                "properties": { "renderer": { "const": "stellar-v1" } }
              }
            }
          },
          "then": { "properties": { "scheme": { "const": "dark" } } }
        }
      ],
      "type": "object",
      "required": ["ui", "background"],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "schemaVersion": { "const": 2 },
        "name": {},
        "author": {},
        "cover": {},
        "scheme": {},
        "colors": {},
        "ui": { "$ref": "#/definitions/ui" },
        "background": { "$ref": "#/definitions/background" }
      }
    },
    "colors": {
      "type": "object",
      "required": ["bg", "side", "surface", "ink", "muted", "border", "code", "accent"],
      "properties": {
        "bg": { "$ref": "#/definitions/color" },
        "side": { "$ref": "#/definitions/color" },
        "surface": { "$ref": "#/definitions/color" },
        "ink": { "$ref": "#/definitions/color" },
        "muted": { "$ref": "#/definitions/color" },
        "border": { "$ref": "#/definitions/color" },
        "code": { "$ref": "#/definitions/color" },
        "accent": { "$ref": "#/definitions/color" }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "ui": {
      "type": "object",
      "required": ["renderer"],
      "additionalProperties": false,
      "properties": { "renderer": { "enum": ["standard-v1", "stellar-v1"] } }
    },
    "accepts": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "default": [],
      "items": { "const": "image-v1" }
    },
    "background": {
      "oneOf": [
        {
          "type": "object",
          "required": ["renderer"],
          "additionalProperties": false,
          "properties": {
            "renderer": { "const": "solid-v1" },
            "accepts": { "$ref": "#/definitions/accepts" }
          }
        },
        {
          "type": "object",
          "required": ["renderer", "source"],
          "additionalProperties": false,
          "properties": {
            "renderer": { "const": "stellar-v1" },
            "source": { "const": "scene.json" },
            "accepts": { "$ref": "#/definitions/accepts" }
          }
        },
        {
          "type": "object",
          "required": ["renderer", "source"],
          "additionalProperties": false,
          "properties": {
            "renderer": { "const": "image-v1" },
            "source": { "enum": ["background.png", "background.jpg"] },
            "accepts": { "$ref": "#/definitions/accepts" }
          }
        }
      ]
    }
  }
}
