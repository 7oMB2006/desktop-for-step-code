+	let extraPids: number[] = [];
+	if (process.platform === "win32" && win32.basename(shellConfig.shell).toLowerCase() === "bash.exe") {
+		let root = win32.dirname(win32.dirname(shellConfig.shell));
+		if (win32.basename(root).toLowerCase() === "usr") root = win32.dirname(root);
