+++ b/packages/coding-agent/src/modes/rpc/desktop-btw.ts
@@ -0,0 +1,122 @@
+import type { AssistantMessage, Message } from "@step-harness/providers";
+import type { AgentSession } from "../../core/agent-session.ts";
+import { convertToLlm } from "../../core/messages.ts";
+
+const reminder = [
+	"<system-reminder>This is a side question from the user. Answer it directly in a single response.",
+	"Tools are unavailable. Do not continue, plan, or edit anything for the main task.</system-reminder>",
+].join("\n");
+const identity = (value: unknown): value is string => typeof value === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(value);
+const text = (message: AssistantMessage) =>
+	message.content.filter((block) => block.type === "text").map((block) => block.text).join("");
+
+/** Keep only a complete prefix: an in-flight tool call must not reach a second request unpaired. */
+export function btwContext(messages: Message[]): Message[] {
+	for (let i = 0; i < messages.length; i++) {
+		const message = messages[i];
+		if (message.role !== "assistant") continue;
+		const calls = message.content.filter((block) => block.type === "toolCall");
+		if (!calls.length) continue;
+		const results = new Set<string>();
+		let next = i + 1;
+		while (messages[next]?.role === "toolResult") {
+			results.add((messages[next] as { toolCallId: string }).toolCallId);
+			next++;
+		}
+		if (calls.some((call) => !results.has(call.id))) return messages.slice(0, i);
+	}
+	return messages;
+}
+
+/** A model-only fork, never an agent, session entry, or main-turn event. */
+export class DesktopBtw {
+	private readonly session: () => AgentSession;
+	private readonly output: (event: object) => void;
+	private scope?: string;
+	private history: { question: string; message: AssistantMessage }[] = [];
+	private active?: { requestId: string; scopeId: string; controller: AbortController; settled: Promise<void> };
+	constructor(session: () => AgentSession, output: (event: object) => void) {
+		this.session = session;
+		this.output = output;
+	}
+
+	start(input: { requestId: string; scopeId: string; sessionId: string; question: string }): void {
+		const session = this.session();
+		if (!identity(input.requestId) || !identity(input.scopeId) || input.sessionId !== session.sessionManager.getSessionId()
+			|| typeof input.question !== "string" || !input.question.trim() || input.question.length > 8000)
+			throw new Error("Invalid side question");
+		if (this.active) throw new Error("A side question is already running");
+		if (session.isCompacting || !session.model) throw new Error("Side question is unavailable");
+		if (this.scope !== input.scopeId) { this.scope = input.scopeId; this.history = []; }
+		const question = input.question.trim(), model = session.model;
+		const context = structuredClone({
+			systemPrompt: session.systemPrompt,
+			messages: [
+				...btwContext(convertToLlm(session.agent.state.messages)),
+				...this.history.flatMap(({ question, message }): Message[] => [
+					{ role: "user", content: [{ type: "text", text: question }], timestamp: message.timestamp }, message,
+				]),
+				{ role: "user" as const, content: [{ type: "text" as const, text: `${reminder}\n\n${question}` }], timestamp: Date.now() },
+			],
+		});
+		const active = { requestId: input.requestId, scopeId: input.scopeId, controller: new AbortController(), settled: Promise.resolve() };
+		this.active = active;
+		const emit = (value: object) => this.output({ type: "desktop_btw", requestId: input.requestId,
+			scopeId: input.scopeId, sessionId: input.sessionId, ...value });
+		emit({ kind: "start", model: { id: model.id, provider: model.provider, name: model.name } });
+		active.settled = (async () => {
+			const timer = setTimeout(() => active.controller.abort(), 120_000);
+			let usage: AssistantMessage["usage"] | undefined;
+			try {
+				// Same native auth/provider resolution as upstream /btw; never fall back to another route.
+				const stream = session.modelRuntime.stream(model, context, { signal: active.controller.signal, maxTokens: 2048 });
+				let chars = 0;
+				for await (const event of stream) {
+					if (event.type === "text_delta" && !active.controller.signal.aborted) {
+						chars += event.delta.length;
+						if (chars > 64_000) { active.controller.abort(); break; }
+						emit({ kind: "delta", text: event.delta });
+					}
+				}
+				const message = await stream.result();
+				usage = message.usage;
+				if (active.controller.signal.aborted || message.stopReason === "aborted") emit({ kind: "cancelled", usage });
+				else if (message.stopReason === "error" || message.content.some((block) => block.type === "toolCall")
+					|| !text(message).trim() || text(message).length > 64_000)
+					emit({ kind: "error", usage });
+				else {
+					this.history = [...this.history, { question, message }].slice(-20);
+					while (this.history.length > 1 && this.history.reduce((size, item) => size + item.question.length + text(item.message).length, 0) > 64_000)
+						this.history.shift();
+					emit({ kind: "done", text: text(message), usage, truncated: message.stopReason === "length" });
+				}
+			} catch {
+				// Provider errors can contain credentials or request bodies; only a stable outcome crosses RPC.
+				emit({ kind: active.controller.signal.aborted ? "cancelled" : "error", usage });
+			} finally {
+				clearTimeout(timer);
+				if (this.active === active) this.active = undefined;
+			}
+		})();
+	}
+
+	async cancel(requestId: string, scopeId: string): Promise<void> {
+		const active = this.active;
+		if (!active || active.requestId !== requestId || active.scopeId !== scopeId) return;
+		active.controller.abort();
+		await active.settled;
+	}
+
+	clear(scopeId: string): void {
+		if (this.scope !== scopeId) return;
+		if (this.active) throw new Error("Cancel the side question before clearing history");
+		this.history = [];
+		this.scope = undefined;
+	}
+
+	reset(): void {
+		this.active?.controller.abort();
+		this.history = [];
+		this.scope = undefined;
+	}
+}
