+// Beta desktop transport only. Tool parameters, decision policy and TUI stay upstream-owned.
+async function executeDesktopDialog(
+	questions: NormalizedQuestion[],
+	ctx: ExtensionContext,
+	desktop: { callId: string; signal?: AbortSignal },
+): Promise<StepQuestionnaireDetails> {
+	const value = await ctx.ui.input(
+		`Desktop clarification\n${JSON.stringify({ version: 1, callId: desktop.callId, questions })}`,
+		undefined,
+		{ signal: desktop.signal },
+	);
+	if (value === undefined || desktop.signal?.aborted) return { questions, answers: [], cancelled: true };
+	const raw: unknown = JSON.parse(value);
+	if (!Array.isArray(raw) || raw.length !== questions.length) throw new Error("Incomplete clarification answers");
+	const answers = questions.map((question, i): StepQuestionnaireAnswer => {
+		const answer: unknown = raw[i];
+		if (
+			!isRecord(answer) ||
+			answer.id !== question.id ||
+			typeof answer.value !== "string" ||
+			typeof answer.wasCustom !== "boolean"
+		)
+			throw new Error("Invalid clarification answer");
+		if (answer.wasCustom) {
+			if (!question.allowFreeform || !answer.value.trim()) throw new Error("Invalid custom clarification answer");
+			return { id: question.id, value: answer.value.trim(), label: answer.value.trim(), wasCustom: true };
+		}
+		const index = question.options.findIndex((option) => option.value === answer.value);
+		if (index < 0) throw new Error("Invalid clarification option");
+		return {
+			id: question.id,
+			value: question.options[index].value,
+			label: question.options[index].label,
+			wasCustom: false,
+			index: index + 1,
+		};
+	});
+	return { questions, answers, cancelled: false };
+}
