diff --git a/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts b/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts
@@ -0,0 +1,161 @@
+import { randomUUID } from "node:crypto";
+import type { AgentSession, AgentSessionEvent, PromptOptions } from "../../core/agent-session.ts";
+import { completionCheckFeedback } from "../completion-check.ts";
+
+type Status = "pending" | "reviewing" | "ended" | "failed" | "cancelled" | "skipped";
+type Reason = "input" | "cancelled" | "rebound" | "failure" | "denied" | "approval" | "mode" | "intercepted" | "no_final_text" | "persistence";
+interface Review {
+	version: 1;
+	id: string;
+	sessionId: string;
+	status: Status;
+	sent: boolean;
+	reason?: Reason;
+}
+interface Run {
+	session: AgentSession;
+	state: Review;
+	reason?: Reason;
+	delivered: boolean;
+	finalText: boolean;
+	expected?: string;
+}
+const reasonPriority: Record<Reason, number> = {
+	input: 0, mode: 1, intercepted: 1, no_final_text: 1,
+	failure: 2, denied: 2, approval: 2, cancelled: 3, rebound: 4, persistence: 5,
+};
+function mark(run: Run, reason: Reason): void {
+	if (!run.reason || reasonPriority[reason] > reasonPriority[run.reason]) run.reason = reason;
+}
+function outcome(reason?: Reason): Status {
+	return reason === "cancelled" || reason === "rebound" ? "cancelled"
+		: reason === "failure" || reason === "no_final_text" || reason === "persistence" ? "failed"
+		: reason ? "skipped" : "ended";
+}
+
+/** Owns one explicit RPC task, never an agent_end callback or a recurring reviewer. */
+export class DesktopCompletionReview {
+	private active?: Run;
+	private readonly session: () => AgentSession;
+	private readonly output: (event: object) => void;
+	private readonly eligible: () => boolean;
+	constructor(
+		session: () => AgentSession,
+		output: (event: object) => void,
+		eligible: () => boolean,
+	) { this.session = session; this.output = output; this.eligible = eligible; }
+
+	get running(): boolean { return this.active !== undefined; }
+	skip(reason: "input" | "cancelled" | "rebound"): void {
+		if (this.active && (reason !== "input" || this.active.state.status === "pending"))
+			mark(this.active, reason);
+	}
+
+	async prompt(message: string, options: PromptOptions): Promise<void> {
+		const session = this.session();
+		if (this.active || session.isStreaming || session.isCompacting || session.pendingMessageCount)
+			throw new Error("Completion review requires a new idle task.");
+		if (!this.eligible() || message.trimStart().startsWith("/") || /^(?:ultracode|ultraloop):/i.test(message.trimStart()))
+			throw new Error("Completion review is only available for ordinary main tasks.");
+		const run: Run = { session, state: { version: 1, id: randomUUID(), sessionId: session.sessionId,
+			status: "pending", sent: false }, delivered: false, finalText: false };
+		const cwd = session.sessionManager.getCwd(), model = session.model, thinking = session.thinkingLevel;
+		this.active = run;
+		let accepted = false, finished = false;
+		const persist = () => {
+			try { session.sessionManager.appendCustomEntry("desktop-completion-review", run.state); }
+			catch (error) { mark(run, "persistence"); throw error; }
+		};
+		const output = () => this.output({ type: "desktop_completion_review", review: run.state,
+			completed: !run.reason && run.finalText && run.state.status === "ended" });
+		const publish = (status: Status, reason?: Reason) => {
+			run.state = { ...run.state, status, ...(reason ? { reason } : {}) };
+			persist();
+			output();
+		};
+		const finish = async (status: Status, reason?: Reason) => {
+			if (finished) return;
+			finished = true;
+			run.state = { ...run.state, status, ...(reason ? { reason } : {}) };
+			try {
+				persist();
+				if (accepted && this.session() === session)
+					await session.sendCustomMessage({ customType: "desktop-completion-review-result", display: true,
+						content: `Completion self-review: ${status}${reason ? ` (${reason})` : ""}.`,
+						details: { ...run.state } }, { triggerTurn: false });
+			} catch (error) {
+				mark(run, "persistence");
+				run.state = { ...run.state, status: "failed", reason: "persistence" };
+				// A broken history store must not strand Desktop's task ownership.
+				try { persist(); } catch { /* The terminal event remains authoritative for this live task. */ }
+				output();
+				throw error;
+			}
+			output();
+		};
+		const unsubscribe = session.subscribe((event: AgentSessionEvent) => {
+			if (event.type === "message_start") {
+				if (run.state.status === "pending" && event.message.role === "user") run.delivered = true;
+				if (event.message.role === "custom" && event.message.customType === "desktop-completion-review-input"
+					&& (event.message.details as { reviewId?: string } | undefined)?.reviewId === run.state.id
+					&& (typeof event.message.content === "string" ? event.message.content
+						: event.message.content.filter(part => part.type === "text").map(part => part.text).join("\n")) === run.expected)
+					run.state.sent = true;
+			}
+			if (event.type === "message_end" && event.message.role === "assistant") {
+				const message = event.message;
+				if (message.stopReason === "error") mark(run, "failure");
+				if (message.stopReason === "aborted") mark(run, "cancelled");
+				run.finalText = !["toolUse", "error", "aborted"].includes(message.stopReason)
+					&& !message.content.some(part => part.type === "toolCall")
+					&& message.content.some(part => part.type === "text" && part.text.trim().length > 0);
+			}
+			if (event.type === "tool_execution_end") {
+				const result = event.result as { terminate?: unknown; details?: { outcome?: unknown } } | undefined;
+				if (event.isError && result?.terminate === true) mark(run, "denied");
+				if (!event.isError && event.toolName === "exit_plan_mode" && result?.details?.outcome === "external_approval_required")
+					mark(run, "approval");
+			}
+		});
+		try {
+			// Reserve the task before extension input handlers can themselves run an agent.
+			publish("pending");
+			await session.prompt(message, { ...options, preflightResult: success => {
+				if (success && (run.reason === "cancelled" || run.reason === "rebound"))
+					throw new Error("Task cancelled before delivery.");
+				if (success) accepted = true;
+				options.preflightResult?.(success);
+			} });
+			if (this.session() !== session || session.sessionManager.getCwd() !== cwd) mark(run, "rebound");
+			if (!this.eligible() || session.model !== model || session.thinkingLevel !== thinking) mark(run, "mode");
+			if (!run.delivered) mark(run, "intercepted");
+			if (session.pendingMessageCount) mark(run, "input");
+			if (!run.reason) {
+				publish("reviewing");
+				const feedback = completionCheckFeedback(undefined, run.finalText, true);
+				run.expected = feedback;
+				run.finalText = false;
+				await session.prompt(feedback, {
+					source: "extension", expandPromptTemplates: false,
+					preflightResult: success => {
+						if (success && run.reason) throw new Error("Completion review was cancelled before delivery.");
+					},
+					customMessage: { customType: "desktop-completion-review-input", display: true,
+						details: { version: 1, reviewId: run.state.id, source: "completion-review" } },
+				});
+				if (!run.state.sent) mark(run, "intercepted");
+				else if (!run.finalText) mark(run, "no_final_text");
+			}
+			const reason = run.reason;
+			await finish(outcome(reason), reason);
+		} catch (error) {
+			mark(run, "failure");
+			const reason = run.reason ?? "failure";
+			await finish(outcome(reason), reason);
+			throw error;
+		} finally {
+			unsubscribe();
+			if (this.active === run) this.active = undefined;
+		}
+	}
+}
