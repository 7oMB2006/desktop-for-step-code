+// A moved Desktop conversation must not adopt another conversation's project jobs.
+export class DesktopSessionCronStore extends CronFileStore {
+	private readonly created = new Set<string>();
+	private readonly directory: string;
+	private readonly owner: () => { cwd: string; sessionId: string } | undefined;
+	constructor(filePath: string, directory: string, owner: () => { cwd: string; sessionId: string } | undefined) {
+		super(filePath);
+		this.directory = directory;
+		this.owner = owner;
+	}
+	private identity(job: CronJob): string {
+		return JSON.stringify([job.id, job.createdAt]);
+	}
+	private bindingKey(cwd: string, job: CronJob): string {
+		const workspace = (process.platform === "win32" ? cwd.replace(/\\/g, "/") : cwd).replace(/\/+$/, "");
+		return JSON.stringify([process.platform === "win32" ? workspace.toLowerCase() : workspace, job.id, job.createdAt]);
+	}
+	private owns(job: CronJob): boolean {
+		const owner = this.owner();
+		if (!owner) return false;
+		const key = this.bindingKey(owner.cwd, job);
+		if (this.created.has(JSON.stringify([owner.sessionId, key]))) return true;
+		try {
+			const bytes = readFileSync(path.join(this.directory, createHash("sha256").update(key).digest("hex") + ".json"));
+			if (bytes.length > 4096) return false;
+			const binding = JSON.parse(bytes.toString("utf8"));
+			return binding.sessionId === owner.sessionId && ["created", "recovered"].includes(binding.source)
+				&& Number.isFinite(binding.at);
+		} catch {
+			// Unowned or unreadable associations stay in the shared file, never adopted.
+			return false;
+		}
+	}
+	override load(): CronJob[] {
+		return super.load().filter((job) => this.owns(job));
+	}
+	override update(mutate: (jobs: CronJob[]) => readonly CronJob[]): void {
+		const newlyCreated: string[] = [];
+		super.update((stored) => {
+			const owned: CronJob[] = [], foreign: CronJob[] = [];
+			for (const job of stored) (this.owns(job) ? owned : foreign).push(job);
+			const next = mutate(owned);
+			if (next.some((job) => foreign.some((other) => other.id === job.id)))
+				throw new Error("Cron job identity conflicts with another conversation");
+			if (next.length + foreign.length > MAX_JOBS)
+				throw new Error(`At most ${MAX_JOBS} cron jobs can be scheduled in a project`);
+			const owner = this.owner();
+			if (owner) for (const job of next) {
+				if (stored.some((other) => this.identity(other) === this.identity(job))) continue;
+				const key = this.bindingKey(owner.cwd, job);
+				newlyCreated.push(JSON.stringify([owner.sessionId, key]));
+			}
+			return [...foreign, ...next];
+		});
+		// Only keep local ownership after the shared-file transaction succeeds.
+		for (const key of newlyCreated) this.created.add(key);
+	}
+}
