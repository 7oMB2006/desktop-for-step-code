+type DarwinProcessIdentity = { pid: number; ppid: number; started: string };
+
+function readDarwinProcessTable(pid?: number): DarwinProcessIdentity[] {
+	// Use the system ps directly: PATH and user shell startup files are untrusted.
+	// lstart survives reparenting, so a detached descendant can be rechecked after
+	// its original parent was killed. Never infer ownership from command names.
+	const result = spawnSync("/bin/ps", [...(pid ? ["-p", String(pid)] : ["-axo", "pid=,ppid=,lstart="]),
+		...(pid ? ["-o", "pid=,ppid=,lstart="] : [])], {
+		encoding: "utf8", timeout: 2000, maxBuffer: 4 * 1024 * 1024,
+		env: { ...process.env, LC_ALL: "C" },
+	});
+	if (result.error || result.status !== 0) return [];
+	return result.stdout.split(/\r?\n/).flatMap((line) => {
+		const match = /^\s*(\d+)\s+(\d+)\s+([A-Za-z]{3} [A-Za-z]{3}\s+\d+ \d{2}:\d{2}:\d{2} \d{4})\s*$/u.exec(line);
+		if (!match) return [];
+		const pid = Number(match[1]), ppid = Number(match[2]);
+		return Number.isSafeInteger(pid) && pid > 0 && Number.isSafeInteger(ppid) && ppid >= 0
+			? [{ pid, ppid, started: match[3] }] : [];
+	});
+}
+
+function getDarwinDescendants(pid: number): DarwinProcessIdentity[] {
+	const table = readDarwinProcessTable();
+	const owned = new Set([pid]);
+	const descendants: DarwinProcessIdentity[] = [];
+	for (let changed = true; changed;) {
+		changed = false;
+		for (const row of table) {
+			if (!owned.has(row.pid) && owned.has(row.ppid)) {
+				owned.add(row.pid);
+				descendants.push(row);
+				changed = true;
+			}
+		}
+	}
+	return descendants;
+}
