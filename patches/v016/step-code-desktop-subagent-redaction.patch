new file mode 100644
index 0000000..93444f6
--- /dev/null
+++ b/packages/coding-agent/src/features/subagent/display-text.ts
@@ -0,0 +1,19 @@
+const SENSITIVE_LINE =
+	/(api[-_.]?key|access[-_]?token|refresh[-_]?token|auth[-_]?token|secret|password|passwd|credential|cookie|authorization|bearer\s+[A-Za-z0-9._-]|['"]?(?:token|apiKey|api_key)['"]?\s*[:=]|^\s*(?:STEP|PI|AI_AGENT)[A-Z0-9_]*\s*=)/i;
+
+export function redactPartialText(text: string | undefined, partial = false): string | undefined {
+	if (text === undefined) return undefined;
+	if (!partial) return redactSensitiveText(text);
+	const boundary = text.search(/[\r\n]/u);
+	return redactSensitiveText(boundary < 0 ? "" : text.slice(boundary + 1));
+}
+
+export function redactSensitiveText(text: string): string;
+export function redactSensitiveText(text: string | undefined): string | undefined;
+export function redactSensitiveText(text: string | undefined): string | undefined {
+	if (text === undefined) return undefined;
+	return text
+		.split(/(\r\n|\n|\r)/u)
+		.map((line, index) => (index % 2 || !line.trim() || !SENSITIVE_LINE.test(line) ? line : "[redacted]"))
+		.join("");
+}
