+test("Desktop RPC owns background lanes through final delivery and clears them on shutdown", async () => {
+	const { api, tools, sent, handlers } = createApi();
+	const snapshots: { version: number; lanes: { id: string; status: string }[] }[] = [];
+	let finish!: () => void;
+	const gate = new Promise<void>((resolve) => {
+		finish = resolve;
+	});
+	const ctx = createContext("/workspace");
+	ctx.mode = "rpc";
+	let parentActive = false;
+	ctx.isIdle = () => !parentActive;
+	const sendMessage = api.sendMessage;
+	api.sendMessage = (message, options) => {
+		parentActive = true;
+		sendMessage(message, options);
+	};
+	ctx.ui.setStatus = (key, value) => {
+		if (key === "desktop-subagents" && value) snapshots.push(JSON.parse(value));
+	};
+	createStepSubagentExtension({
+		includeBuiltinAgents: true,
+		agentDir: "/tmp/step-agent-test",
+		runner: async () => {
+			await gate;
+			return textResult("done");
+		},
+	})(api);
+	try {
+		const result = await tools
+			.get("subagent")!
+			.execute(
+				"call",
+				{ agent: "general", task: "inspect", run_in_background: true } as never,
+				undefined,
+				undefined,
+				ctx,
+			);
+		const id = laneIdOf(result);
+		expect(snapshots.at(-1)).toEqual({ version: 1, parentActive: false, lanes: [{ id, status: "running" }] });
+		finish();
+		await waitFor(() => sent.length > 0);
+		expect(snapshots).toContainEqual({ version: 1, parentActive: false, lanes: [{ id, status: "settling" }] });
+		expect(snapshots.at(-1)).toEqual({ version: 1, parentActive: true, lanes: [] });
+	} finally {
+		finish();
+		parentActive = false;
+		for (const handler of handlers.get("session_shutdown") ?? []) await handler({ reason: "quit" }, ctx);
+	}
+	expect(snapshots.at(-1)).toEqual({ version: 1, parentActive: false, lanes: [] });
+});
