+// Fake `step --mode rpc` child for the subagent live-channel regression.
+//
+// Speaks the real framing (one JSON object per LF-framed line) and streams what
+// a long child produces: text deltas, persisted messages, tool progress. Only
+// its token stream is synthetic; everything it drives on the parent side is the
+// production rpc adapter, parser, orchestration, agent loop and projections.
+//
+// Like the real CLI, progress frames are written only under
+// `--include-live-events`, so a parent that forgets the flag gets no live view
+// and the regression fails instead of passing on durable events alone.
+const TURNS = Number(process.env.STREAM_TURNS ?? 6);
+const DELTAS = Number(process.env.STREAM_DELTAS ?? 20);
+const TOOL_BYTES = Number(process.env.STREAM_TOOL_BYTES ?? 4_000);
+// A real child streams over seconds; the parent coalesces frames on a 100ms
+// repaint window, so a child that finishes in a few milliseconds publishes only
+// its first and last frame. Tests that assert streamed text must let the child
+// outlive that window.
+const DELAY_MS = Number(process.env.STREAM_DELAY_MS ?? 0);
+// The real CLI writes `message_update`/`tool_execution_update` only when the
+// caller opted in; a fixture that always emitted them would let a parent test
+// pass even if the flag were never passed. Mirror the CLI: no flag, no frames.
+const LIVE = process.argv.includes("--include-live-events");
+/** Appears only in a progress frame, never in a final tool result. */
+const PROGRESS_MARKER = "tool-progress-marker";
+
+let buffer = "";
+/** Frames must reach stdout in order, so handle() calls are serialized. */
+let queue = Promise.resolve();
+process.stdin.setEncoding("utf8");
+process.stdin.on("data", (chunk) => {
+	buffer += chunk;
+	const lines = buffer.split("\n");
+	buffer = lines.pop() ?? "";
+	for (const line of lines) queue = queue.then(() => handle(line.trim()));
+});
+
+function write(value) {
+	process.stdout.write(`${JSON.stringify(value)}\n`);
+}
+
+function assistant(content, stopReason = "stop") {
+	return {
+		role: "assistant",
+		content,
+		api: "anthropic-messages",
+		provider: "step",
+		model: "step-3.8-code-alpha",
+		usage: { input: 100, output: 50, cacheRead: 0, cacheWrite: 0, totalTokens: 150, cost: {} },
+		stopReason,
+		timestamp: Date.now(),
+	};
+}
+
+function sleep(ms) {
+	return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function handle(line) {
+	if (!line) return;
+	let command;
+	try {
+		command = JSON.parse(line);
+	} catch {
+		return;
+	}
+	if (command.type === "get_state") {
+		write({
+			type: "response",
+			id: command.id,
+			command: "get_state",
+			success: true,
+			data: { sessionFile: "/tmp/stream-child-session.jsonl" },
+		});
+		return;
+	}
+	if (command.type === "abort") {
+		write({ type: "agent_settled" });
+		return;
+	}
+	if (command.type !== "prompt") return;
+
+	write({ type: "response", id: command.id, command: "prompt", success: true });
+	write({ type: "agent_start" });
+
+	const messages = [];
+	for (let turn = 0; turn < TURNS; turn++) {
+		write({ type: "turn_start" });
+		write({ type: "message_start", message: assistant([]) });
+		let text = "";
+		for (let index = 0; index < DELTAS; index++) {
+			const delta = `token-${turn}-${index} `;
+			text += delta;
+			if (LIVE) {
+				write({ type: "message_update", assistantMessageEvent: { type: "text_delta", contentIndex: 0, delta } });
+			}
+			if (DELAY_MS > 0) await sleep(DELAY_MS);
+		}
+		const message = assistant([{ type: "text", text }], "toolUse");
+		messages.push(message);
+		write({ type: "message_end", message });
+
+		const toolCallId = `call_${turn}`;
+		const output = "x".repeat(TOOL_BYTES);
+		write({ type: "tool_execution_start", toolCallId, toolName: "run_command", args: { command: `echo ${turn}` } });
+		if (LIVE) {
+			// A real tool's progress snapshot carries something the final result
+			// does not: a counter, a spinner, a partial line. Marking it that way
+			// lets a parent test prove it read a *frame* rather than the durable
+			// value that `message_end` also provides.
+			write({
+				type: "tool_execution_update",
+				toolCallId,
+				toolName: "run_command",
+				partialResult: {
+					content: [{ type: "text", text: `${output}\nprogress ${PROGRESS_MARKER}` }],
+				},
+			});
+			// A real tool's progress is observable for a while; without pacing the
+			// start/update/end triple lands inside one repaint window and the parent
+			// never publishes a frame mid-tool.
+			if (DELAY_MS > 0) await sleep(DELAY_MS * 3);
+		}
+		const result = {
+			role: "toolResult",
+			toolCallId,
+			toolName: "run_command",
+			content: [{ type: "text", text: output }],
+			isError: false,
+			timestamp: Date.now(),
+		};
+		messages.push(result);
+		write({
+			type: "tool_execution_end",
+			toolCallId,
+			toolName: "run_command",
+			result: { content: [{ type: "text", text: output }] },
+			isError: false,
+		});
+		write({ type: "message_end", message: result });
+		write({ type: "turn_end" });
+	}
+
+	write({ type: "message_end", message: assistant([{ type: "text", text: "child done" }]) });
+	write({ type: "agent_end" });
+	write({ type: "agent_settled" });
+}
diff --git a/packages/coding-agent/test/json-event-backstop.test.ts b/packages/coding-agent/test/json-event-backstop.test.ts
new file mode 100644
index 0000000..6219f1d
--- /dev/null
+++ b/packages/coding-agent/test/json-event-backstop.test.ts
@@ -0,0 +1,69 @@
+import { expect, test } from "vitest";
+import type { AgentSessionEvent } from "../src/core/agent-session.ts";
+import { MAX_LIVE_UPDATE_BYTES, toJsonEvent } from "../src/modes/json-event.ts";
+
+function frame(text: string, details: unknown = {}): Extract<AgentSessionEvent, { type: "tool_execution_update" }> {
+	return {
+		type: "tool_execution_update",
+		toolCallId: "call",
+		toolName: "probe",
+		args: { input: "start" },
+		partialResult: { content: [{ type: "text", text }], details },
+	};
+}
+
+test("under-budget tool frames pass through by identity", () => {
+	const event = frame("short");
+	expect(toJsonEvent(event, { includeLiveEvents: true })).toBe(event);
+});
+
+test.each([
+	["ASCII", "r"],
+	["control", "\u0001"],
+	["quotes and backslashes", '"\\'],
+	["CJK", "中"],
+	["lone surrogate", "\ud800"],
+])("bounds serialized bytes for 4 MiB %s text", (_label, character) => {
+	const text = `${character.repeat(4 * 1024 * 1024)}TAIL`;
+	const event = frame(text);
+	const projected = toJsonEvent(event, { includeLiveEvents: true })!;
+	expect(Buffer.byteLength(JSON.stringify(projected))).toBeLessThanOrEqual(MAX_LIVE_UPDATE_BYTES);
+	expect(projected).not.toHaveProperty("args");
+	expect(projected).not.toHaveProperty("partialResult.details");
+	expect(projected).toHaveProperty("partialResult.content.0.text", expect.stringContaining("[live output truncated]"));
+	expect(projected).toHaveProperty("partialResult.content.0.text", expect.stringMatching(/TAIL$/));
+	expect(event.partialResult.content[0].text).toBe(text);
+});
+
+test("oversized identifiers cannot prevent reaching the floor", () => {
+	const event = {
+		...frame("x"),
+		toolCallId: "\u0001".repeat(4 * 1024 * 1024),
+		toolName: "中".repeat(4 * 1024 * 1024),
+	};
+	const projected = toJsonEvent(event, { includeLiveEvents: true })!;
+	expect(Buffer.byteLength(JSON.stringify(projected))).toBeLessThanOrEqual(MAX_LIVE_UPDATE_BYTES);
+	expect(projected).toHaveProperty("toolCallId", event.toolCallId.slice(0, 200));
+	expect(projected).toHaveProperty("toolName", event.toolName.slice(0, 200));
+});
+
+test("one-character text with oversized details terminates without restoring details", () => {
+	const event = frame("x", { huge: "r".repeat(4 * 1024 * 1024) });
+	const projected = toJsonEvent(event, { includeLiveEvents: true })!;
+	expect(Buffer.byteLength(JSON.stringify(projected))).toBeLessThanOrEqual(MAX_LIVE_UPDATE_BYTES);
+	expect(projected).not.toHaveProperty("partialResult.details");
+});
+
+test("terminal tool results are never bounded", () => {
+	const event: AgentSessionEvent = {
+		type: "tool_execution_end",
+		toolCallId: "call",
+		toolName: "probe",
+		result: frame("r".repeat(4 * 1024 * 1024)).partialResult,
+		isError: false,
+	};
+	expect(toJsonEvent(event, { includeLiveEvents: true })).toBe(event);
+	expect(Buffer.byteLength(JSON.stringify(toJsonEvent(event, { includeLiveEvents: true })))).toBeGreaterThan(
+		MAX_LIVE_UPDATE_BYTES,
+	);
+});
diff --git a/packages/coding-agent/test/json-event-projection.test.ts b/packages/coding-agent/test/json-event-projection.test.ts
new file mode 100644
index 0000000..7870353
--- /dev/null
+++ b/packages/coding-agent/test/json-event-projection.test.ts
@@ -0,0 +1,233 @@
+import { fauxAssistantMessage, fauxToolCall } from "@step-harness/providers";
+import { Type } from "typebox";
+import { expect, test } from "vitest";
+import type { AgentSessionEvent } from "../src/core/agent-session.ts";
+import { sessionEventDurability } from "../src/core/session-event-durability.ts";
+import { toJsonEvent } from "../src/modes/json-event.ts";
+import { createHarness } from "./suite/harness.ts";
+
+/**
+ * The stdout projection is the only place that decides what a serialized
+ * transport writes. Two properties matter, and they are separate:
+ *
+ *   1. a frame is never written unless the caller opts in;
+ *   2. a boundary event (`turn_end`, `agent_end`) reports where it fell instead
+ *      of re-sending the messages it closes over.
+ *
+ * What the projection deliberately keeps is also pinned here: a message is
+ * written on its `message_start`/`message_end` pair, and a tool result also on
+ * `tool_execution_end`. Those are sequence semantics, not duplicates.
+ */
+
+const assistantMessage = {
+	role: "assistant",
+	content: [{ type: "text", text: "done" }],
+	api: "anthropic-messages",
+	provider: "step",
+	model: "m",
+	usage: {
+		input: 1,
+		output: 1,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 2,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	},
+	stopReason: "stop",
+	timestamp: 1,
+};
+
+const toolResultMessage = {
+	role: "toolResult",
+	toolCallId: "call_1",
+	toolName: "run_command",
+	content: [{ type: "text", text: "x".repeat(20_000) }],
+	isError: false,
+	timestamp: 2,
+};
+
+const messageEnd = { type: "message_end", message: assistantMessage } as unknown as AgentSessionEvent;
+
+const turnEnd = {
+	type: "turn_end",
+	message: assistantMessage,
+	toolResults: [toolResultMessage],
+} as unknown as AgentSessionEvent;
+
+const agentEnd = {
+	type: "agent_end",
+	messages: [assistantMessage, toolResultMessage],
+	willRetry: false,
+} as unknown as AgentSessionEvent;
+
+test("frames are absent from the record unless the caller opts in", () => {
+	const messageUpdate = {
+		type: "message_update",
+		message: assistantMessage,
+		assistantMessageEvent: { type: "text_delta", contentIndex: 0, delta: "hi" },
+	} as unknown as AgentSessionEvent;
+	const toolUpdate = {
+		type: "tool_execution_update",
+		toolCallId: "call_1",
+		toolName: "run_command",
+		args: { command: "ls" },
+		partialResult: { content: [{ type: "text", text: "partial" }] },
+	} as unknown as AgentSessionEvent;
+
+	for (const frame of [messageUpdate, toolUpdate]) {
+		expect(toJsonEvent(frame)).toBeUndefined();
+		expect(toJsonEvent(frame, { includeLiveEvents: false })).toBeUndefined();
+		expect(toJsonEvent(frame, { includeLiveEvents: true })).toBeDefined();
+	}
+});
+
+test("a fact is unchanged by the projection", () => {
+	expect(toJsonEvent(messageEnd)).toBe(messageEnd);
+	const start = { type: "turn_start" } as unknown as AgentSessionEvent;
+	expect(toJsonEvent(start)).toBe(start);
+	const settled = { type: "agent_settled" } as unknown as AgentSessionEvent;
+	expect(toJsonEvent(settled)).toBe(settled);
+});
+
+test("turn_end drops the messages it closes over but keeps the boundary", () => {
+	const projected = toJsonEvent(turnEnd);
+	expect(projected).toEqual({ type: "turn_end", messageRole: "assistant", toolResultCount: 1 });
+	// The 20 KB tool result is not re-sent here.
+	expect(Buffer.byteLength(JSON.stringify(projected))).toBeLessThan(200);
+});
+
+test("agent_end drops the messages it re-sends but keeps the retry signal", () => {
+	const projected = toJsonEvent({ ...agentEnd, willRetry: true } as unknown as AgentSessionEvent);
+	expect(projected).toEqual({ type: "agent_end", willRetry: true, messageCount: 2 });
+	expect(Buffer.byteLength(JSON.stringify(projected))).toBeLessThan(200);
+});
+
+test("a boundary with nothing to close over still projects", () => {
+	// An aborted run emits turn_end with no tool results; an empty run emits
+	// agent_end with no messages. Neither may throw or keep a stale payload.
+	expect(
+		toJsonEvent({ type: "turn_end", message: assistantMessage, toolResults: [] } as unknown as AgentSessionEvent),
+	).toEqual({ type: "turn_end", messageRole: "assistant", toolResultCount: 0 });
+	expect(toJsonEvent({ type: "agent_end", messages: [], willRetry: false } as unknown as AgentSessionEvent)).toEqual({
+		type: "agent_end",
+		willRetry: false,
+		messageCount: 0,
+	});
+});
+
+test("every durable type is either passed through or projected", () => {
+	// The type union above must stay exhaustive: a new durable event that is
+	// neither projected nor passed through would surface as a type error, and
+	// this test names the current set so a removal is visible in review.
+	const durableTypes = ["message_end", "tool_execution_end", "turn_end", "agent_end", "agent_settled"] as const;
+	for (const type of durableTypes) {
+		expect(sessionEventDurability({ type } as AgentSessionEvent)).toBe("durable");
+	}
+});
+
+interface WireHit {
+	type: string;
+	bytes: number;
+}
+
+/**
+ * Run one real prompt through a local tool and record every line a writer would
+ * put on stdout, plus which of them carry a given marker.
+ */
+async function collectWire(
+	marker: string,
+	outputChars: number,
+): Promise<{ hits: WireHit[]; totalBytes: number; types: string[] }> {
+	const harness = await createHarness({
+		extensionFactories: [
+			{
+				name: "probe-tool",
+				factory: (pi) => {
+					pi.registerTool({
+						name: "probe",
+						label: "Probe",
+						description: "returns a sized payload",
+						parameters: Type.Object({}),
+						execute: async () => ({
+							content: [{ type: "text", text: `${marker}${"y".repeat(outputChars)}` }],
+							details: { marker },
+						}),
+					});
+				},
+			},
+		],
+	});
+	try {
+		const hits: WireHit[] = [];
+		let totalBytes = 0;
+		const types: string[] = [];
+		harness.session.subscribe((event) => {
+			const projected = toJsonEvent(event);
+			if (!projected) return;
+			const line = JSON.stringify(projected);
+			const bytes = Buffer.byteLength(line, "utf8");
+			totalBytes += bytes;
+			types.push(String(projected.type));
+			if (line.includes(marker)) hits.push({ type: String(projected.type), bytes });
+		});
+		harness.setResponses([
+			fauxAssistantMessage(fauxToolCall("probe", {}), { stopReason: "toolUse" }),
+			fauxAssistantMessage(`${marker}-assistant`),
+		]);
+		await harness.session.prompt("run probe");
+		return { hits, totalBytes, types };
+	} finally {
+		harness.cleanup();
+	}
+}
+
+test("a real run writes no frame and no boundary payload", async () => {
+	const { hits, types } = await collectWire("FACT_MARKER", 40_000);
+
+	// Frames never appear on the default channel.
+	expect(types).not.toContain("message_update");
+	expect(types).not.toContain("tool_execution_update");
+
+	// The boundaries carry structure only, never the 40 KB payload.
+	for (const type of ["turn_end", "agent_end"]) expect(types).toContain(type);
+	expect(hits.map((hit) => hit.type)).not.toContain("turn_end");
+	expect(hits.map((hit) => hit.type)).not.toContain("agent_end");
+
+	// What the projection keeps, pinned so the docs cannot overclaim. A tool
+	// result travels on `tool_execution_end` (its outcome) plus its own
+	// `message_start`/`message_end` pair (framing) — three. The assistant answer
+	// travels once, on `message_end`; its `message_start` is the empty partial
+	// that streaming builds from.
+	expect(hits.filter((hit) => hit.type === "tool_execution_end")).toHaveLength(1);
+	expect(hits.filter((hit) => hit.type === "message_start")).toHaveLength(1);
+	// Two `message_end`s: the tool result, and the assistant's final answer. Both
+	// carry the marker, which is why the multiplier below is measured per added
+	// character rather than per event.
+	expect(hits.filter((hit) => hit.type === "message_end")).toHaveLength(2);
+});
+
+test("a payload is written a fixed number of times, whatever its size", async () => {
+	const smallChars = 1_000;
+	const largeChars = 40_000;
+	const small = await collectWire("SIZE_MARKER", smallChars);
+	const large = await collectWire("SIZE_MARKER", largeChars);
+
+	// Exactly the same event sequence; only the payload inside it grew.
+	expect(large.types).toEqual(small.types);
+
+	// The marginal bytes per added character are the number of copies the
+	// projection keeps — three: `tool_execution_end` plus the tool result's
+	// `message_start`/`message_end` pair. A repeated transcript would make this
+	// grow with the number of events instead of staying constant.
+	const perChar = (large.totalBytes - small.totalBytes) / (largeChars - smallChars);
+	expect(perChar).toBeGreaterThan(2.5);
+	expect(perChar).toBeLessThan(3.5);
+});
+
+test("the record is bounded per line even with a large payload", async () => {
+	const { hits } = await collectWire("BOUND_MARKER", 40_000);
+	for (const hit of hits) expect(hit.bytes).toBeLessThan(1024 * 1024);
+	// The payload is not replicated per event: one tool result, one assistant
+	// message, one execution outcome.
+	expect(hits.length).toBe(4);
+});
diff --git a/packages/coding-agent/test/json-mode-durability.test.ts b/packages/coding-agent/test/json-mode-durability.test.ts
new file mode 100644
index 0000000..99082ae
--- /dev/null
+++ b/packages/coding-agent/test/json-mode-durability.test.ts
@@ -0,0 +1,170 @@
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterEach, expect, test } from "vitest";
+
+/**
+ * The end-to-end guard for the log amplification, on the real CLI.
+ *
+ * `--mode json` is what a harness redirects to `stepcode.jsonl`, so this spawns
+ * the real entry point with an offline provider, has a tool stream progress
+ * frames, and inspects the actual stdout. A JSON run is a record of facts:
+ * progress belongs to live consumers, which opt in explicitly.
+ */
+
+const cli = fileURLToPath(new URL("../../../apps/cli/src/main.ts", import.meta.url));
+const fixture = fileURLToPath(new URL("./fixtures/streaming-provider.ts", import.meta.url));
+
+const roots: string[] = [];
+
+afterEach(() => {
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+interface RunResult {
+	stdout: string;
+	stderr: string;
+	status: number | null;
+	events: Array<Record<string, unknown>>;
+}
+
+function runJson(extraFlags: string[] = []): RunResult {
+	const root = mkdtempSync(join(tmpdir(), "step-json-durability-"));
+	roots.push(root);
+	const env: NodeJS.ProcessEnv = {
+		HOME: root,
+		USERPROFILE: root,
+		XDG_CONFIG_HOME: join(root, ".config"),
+		XDG_CACHE_HOME: join(root, ".cache"),
+		STEP_CODING_AGENT_DIR: join(root, "config", "agent"),
+		STEPCODE_STORAGE_ROOT_DIR: join(root, "storage"),
+		STEP_NO_LOCAL_LLM: "1",
+		AWS_EC2_METADATA_DISABLED: "true",
+		NODE_ENV: "test",
+		FORCE_COLOR: "0",
+		TMPDIR: root,
+	};
+	for (const name of ["PATH", "SystemRoot", "SYSTEMROOT", "WINDIR", "COMSPEC", "PATHEXT"]) {
+		if (process.env[name] !== undefined) env[name] = process.env[name];
+	}
+	// The provider fixture runs offline; keep MCP from reaching the network.
+	writeFileSync(join(root, "config.toml"), "");
+	const entry = join(root, "entry.mjs");
+	writeFileSync(entry, `await import(${JSON.stringify(cli)});`);
+
+	const result = spawnSync(
+		process.execPath,
+		[
+			"--import",
+			import.meta.resolve("tsx"),
+			entry,
+			"--provider",
+			"stream-offline",
+			"--model",
+			"faux-1",
+			"--api-key",
+			"offline-test-key",
+			"--tools",
+			"stream_probe",
+			"--no-extensions",
+			"--no-skills",
+			"--no-prompt-templates",
+			"--no-context-files",
+			"--no-session",
+			"--no-update-check",
+			// The probe tool is treated as a workspace-mutating tool by the default
+			// policy; this run is offline and has no human to approve it.
+			"--non-interactive-approval",
+			"allow",
+			"--mode",
+			"json",
+			"-e",
+			fixture,
+			...extraFlags,
+			"probe",
+		],
+		{ cwd: root, env, encoding: "utf8", timeout: 60_000, maxBuffer: 16 * 1024 * 1024 },
+	);
+
+	const events: Array<Record<string, unknown>> = [];
+	for (const line of (result.stdout ?? "").split("\n")) {
+		const trimmed = line.trim();
+		if (!trimmed.startsWith("{")) continue;
+		try {
+			const parsed = JSON.parse(trimmed) as unknown;
+			if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+				events.push(parsed as Record<string, unknown>);
+			}
+		} catch {
+			// Not an event line; the assertion below reports what did arrive.
+		}
+	}
+	return { stdout: result.stdout ?? "", stderr: result.stderr ?? "", status: result.status, events };
+}
+
+function typesOf(events: Array<Record<string, unknown>>): string[] {
+	return events.map((event) => String(event.type ?? ""));
+}
+
+// Each case spawns the real CLI through tsx; that startup alone can exceed the
+// default 30s budget on a loaded CI runner.
+const TIMEOUT_MS = 180_000;
+
+test(
+	"a json run writes facts, not live progress",
+	() => {
+		const result = runJson();
+		expect(result.status, result.stderr).toBe(0);
+
+		const types = typesOf(result.events);
+		// The tool really did stream, and the run really did complete.
+		expect(types).toContain("tool_execution_start");
+		expect(types).toContain("tool_execution_end");
+		expect(types).toContain("message_end");
+		// Progress frames are live-only, so the record has none of them.
+		expect(types).not.toContain("tool_execution_update");
+		expect(types).not.toContain("message_update");
+	},
+	TIMEOUT_MS,
+);
+
+test(
+	"turn_end and agent_end keep the boundary, not a second copy of the messages",
+	() => {
+		const result = runJson();
+		expect(result.status, result.stderr).toBe(0);
+
+		const turnEnds = result.events.filter((event) => event.type === "turn_end");
+		const agentEnds = result.events.filter((event) => event.type === "agent_end");
+		expect(turnEnds.length).toBeGreaterThan(0);
