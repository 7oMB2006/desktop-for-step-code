+test("Desktop reply during final settlement explicitly confirms non-delivery", async () => {
+	const { api, tools, sent, handlers } = createApi();
+	const ctx = createContext("/workspace");
+	ctx.mode = "rpc";
+	let refused: Promise<unknown> | undefined;
+	let calls = 0;
+	const gate = deferred();
+	ctx.ui.setStatus = (key, value) => {
+		if (key !== "desktop-subagents" || !value || refused) return;
+		const lane = JSON.parse(value).lanes.find((entry: { status: string }) => entry.status === "settling");
+		if (lane)
+			refused = tools
+				.get("agent_send")!
+				.execute(
+					"desktop-background-reply:settling",
+					{ lane_id: lane.id, action: "reply", prompt: "supplement" },
+					undefined,
+					undefined,
+					ctx,
+				);
+	};
+	createStepSubagentExtension({
+		agentDir: "/tmp/step-agent-test",
+		runner: async () => {
+			calls++;
+			await gate.promise;
+			return textResult("done");
+		},
+	})(api);
+	try {
+		const start = await tools
+			.get("subagent")!
+			.execute("start", { agent: "general", task: "inspect", run_in_background: true }, undefined, undefined, ctx);
+		gate.resolve();
+		await waitFor(() => sent.length === 1);
+		expect(refused).toBeDefined();
+		expect(await refused).toMatchObject({ delivery: "not_sent" });
+		expect(calls).toBe(1);
+		const retry = await tools
+			.get("agent_send")!
+			.execute(
+				"desktop-background-reply:settling",
+				{ lane_id: laneIdOf(start), action: "reply", prompt: "supplement" },
+				undefined,
+				undefined,
+				ctx,
+			);
+		expect(retry).toMatchObject({ delivery: "started" });
+		await waitFor(() => sent.length === 2);
+		expect(calls).toBe(2);
+	} finally {
+		gate.resolve();
+		for (const handler of handlers.get("session_shutdown") ?? []) await handler({ reason: "quit" }, ctx);
+	}
+});
+
