diff --git a/packages/coding-agent/test/desktop-background-replies.test.ts b/packages/coding-agent/test/desktop-background-replies.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ea7fa101b0c61628c812e744b360cb204dd09132
--- /dev/null
+++ b/packages/coding-agent/test/desktop-background-replies.test.ts
@@ -0,0 +1,135 @@
+import { Type } from "typebox";
+import { expect, test, vi } from "vitest";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import { runRpcMode } from "../src/modes/rpc/rpc-mode.ts";
+import { createHarness } from "./suite/harness.ts";
+
+const io = vi.hoisted(() => ({
+	lines: [] as string[],
+	handler: undefined as ((line: string) => void) | undefined,
+}));
+vi.mock("../src/core/output-guard.js", () => ({
+	flushRawStdout: vi.fn(async () => {}),
+	takeOverStdout: vi.fn(),
+	waitForRawStdoutBackpressure: vi.fn(async () => {}),
+	writeRawStdout: (line: string) => io.lines.push(line),
+}));
+vi.mock("../src/theme/theme.js", () => ({ theme: {} }));
+vi.mock("../src/modes/rpc/jsonl.js", () => ({
+	attachJsonlLineReader: vi.fn((_stream: unknown, handler: (line: string) => void) => {
+		io.handler = handler;
+		return () => {};
+	}),
+	serializeJsonLine: (value: unknown) => `${JSON.stringify(value)}\n`,
+}));
+
+for (const outcome of ["not_sent", "missing", "throw"] as const) {
+	test(`background RPC retries only confirmed non-delivery: ${outcome}`, async () => {
+		io.lines = [];
+		io.handler = undefined;
+		type Listener = Parameters<typeof process.on>[1];
+		const signals: NodeJS.Signals[] = process.platform === "win32" ? ["SIGTERM"] : ["SIGTERM", "SIGHUP"];
+		const beforeSignals = new Map(signals.map((signal) => [signal, process.listeners(signal)]));
+		const beforeEnd = process.stdin.listeners("end");
+		let attempts = 0;
+		let release!: () => void;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "agent_send",
+						label: "Agent send",
+						description: "Isolated reply receipt fixture",
+						parameters: Type.Object({ action: Type.String() }),
+						async execute(_id, params) {
+							if (params.action === "status")
+								return {
+									content: [],
+									details: [{ agentId: "lane_12345678", mode: "single", status: "completed" }],
+								};
+							attempts++;
+							if (attempts === 1) {
+								if (outcome === "throw") throw new Error("Injected uncertain result");
+								return {
+									content: [],
+									details: undefined,
+									...(outcome === "not_sent" ? { delivery: "not_sent" } : {}),
+								};
+							}
+							await gate;
+							return { content: [], details: undefined, delivery: "started" };
+						},
+					});
+				},
+			],
+		});
+		try {
+			void runRpcMode({
+				session: harness.session,
+				setRebindSession() {},
+				async dispose() {},
+			} as unknown as AgentSessionRuntime);
+			await vi.waitFor(() => expect(io.handler).toBeDefined());
+			const command = {
+				type: "desktop_subagents",
+				sessionId: harness.session.sessionId,
+				action: "reply",
+				laneId: "lane_12345678",
+				requestId: "12345678-1234-1234-1234-123456789abc",
+				prompt: "Continue",
+			};
+			const send = (id: string, patch = {}) => io.handler!(JSON.stringify({ ...command, ...patch, id }));
+			const response = async (id: string) => {
+				let result: Record<string, any> | undefined;
+				await vi.waitFor(() => {
+					result = io.lines
+						.flatMap((line) => line.trim().split("\n"))
+						.map((line) => JSON.parse(line))
+						.find((entry) => entry.id === id && entry.type === "response");
+					expect(result).toBeDefined();
+				});
+				return result!;
+			};
+			send("initial");
+			expect(await response("initial")).toMatchObject({ success: false });
+			expect(attempts).toBe(1);
+			send("changed", { prompt: "Different" });
+			expect(await response("changed")).toMatchObject({
+				success: false,
+				error: "Background reply identity was reused",
+			});
+			expect(attempts).toBe(1);
+			send("retry-a");
+			send("retry-b");
+			if (outcome === "not_sent") {
+				await vi.waitFor(() => expect(attempts).toBe(2));
+				release();
+				for (const id of ["retry-a", "retry-b"])
+					expect(await response(id)).toMatchObject({
+						id,
+						success: true,
+						data: { delivery: "started" },
+					});
+				send("acknowledged");
+				expect(await response("acknowledged")).toMatchObject({ success: true, data: { delivery: "started" } });
+				expect(attempts).toBe(2);
+			} else {
+				for (const id of ["retry-a", "retry-b"]) expect(await response(id)).toMatchObject({ id, success: false });
+				expect(attempts).toBe(1);
+			}
+		} finally {
+			release();
+			harness.cleanup();
+			for (const listener of process.stdin.listeners("end")) {
+				if (!beforeEnd.includes(listener)) process.stdin.off("end", listener as Listener);
+			}
+			for (const [signal, before] of beforeSignals)
+				for (const listener of process.listeners(signal)) {
+					if (!before.includes(listener)) process.off(signal, listener as Listener);
+				}
+		}
+	});
+}
