+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, expect, test } from "vitest";
+import {
+	type DesktopHostCandidate,
+	DesktopPluginHost,
+	desktopPluginHostCommand,
+} from "../src/step/desktop-plugin-host.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+	await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+async function fixture(sidecar: unknown = { consumer: { server: "example" } }) {
+	const root = await mkdtemp(path.join(tmpdir(), "dfsc-native-host-"));
+	roots.push(root);
+	if (sidecar !== null) await writeFile(path.join(root, "dfsc.host.json"), JSON.stringify(sidecar));
+	const candidate: DesktopHostCandidate = {
+		pluginId: "host-example",
+		pluginRoot: root,
+		name: "host-example__example",
+		declaration: { command: "node", args: ["server.mjs"], cwd: root },
+	};
+	let discovered = [candidate],
+		sessionId = "session-fixture",
+		connected = false,
+		starts = 0;
+	const controller = new AbortController(),
+		owner = {};
+	const host = new DesktopPluginHost(
+		owner,
+		() => sessionId,
+		async () => discovered,
+		controller.signal,
+	);
+	const start = async () => {
+		starts++;
+		connected = true;
+		return true;
+	};
+	const defer = () => host.defer(candidate, start, () => connected);
+	const context = () =>
+		JSON.stringify({
+			version: "dfsc-launch-v1",
+			mode: "follow",
+			pluginId: candidate.pluginId,
+			consumer: "example",
+			sessionId,
+		});
+	return {
+		root,
+		owner,
+		host,
+		candidate,
+		controller,
+		defer,
+		context,
+		starts: () => starts,
+		discover: (items: DesktopHostCandidate[]) => {
+			discovered = items;
+		},
+		session: (value: string) => {
+			sessionId = value;
+		},
+		disconnect: () => {
+			connected = false;
+		},
+	};
+}
+test("only an opted-in plugin consumer is deferred; malformed declarations fail closed", async () => {
+	for (const [declaration, expected, count] of [
+		[null, false, 0],
+		[{}, true, 0],
+		[{ consumer: { server: "other" } }, false, 0],
+		[{ consumer: { server: "example" } }, true, 1],
+	] as const) {
+		const f = await fixture(declaration);
+		expect(await f.defer()).toBe(expected);
+		expect(f.host.list()).toHaveLength(count);
+		expect(f.starts()).toBe(0);
+	}
+});
+test("native records permit a single matching launch, including concurrent replay rejection", async () => {
+	const f = await fixture();
+	await f.defer();
+	const record = f.host.list()[0];
+	await expect(
+		f.host.start(
+			record.requestId,
+			JSON.stringify({
+				version: "dfsc-launch-v1",
+				mode: "follow",
+				pluginId: "wrong",
+				consumer: "example",
+				sessionId: record.sessionId,
+			}),
+		),
+	).rejects.toThrow();
+	const results = await Promise.allSettled([
+		f.host.start(record.requestId, f.context()),
+		f.host.start(record.requestId, f.context()),
+	]);
+	expect(results.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+	expect(f.starts()).toBe(1);
+	expect((await f.host.inspect(record.requestId)).phase).toBe("connected");
+	await expect(f.host.start(record.requestId, f.context())).rejects.toThrow();
+	f.disconnect();
+	await expect(f.host.inspect(record.requestId)).rejects.toThrow();
+});
+test("changed command, plugin root, conflict, removal and global replacement invalidate discovery", async () => {
+	for (const change of [
+		(f: Awaited<ReturnType<typeof fixture>>) => [{ ...f.candidate, declaration: { command: "other" } }],
+		(f: Awaited<ReturnType<typeof fixture>>) => [{ ...f.candidate, pluginRoot: path.join(f.root, "other") }],
+		(f: Awaited<ReturnType<typeof fixture>>) => [{ ...f.candidate, hostConflict: true }],
+		() => [],
+		(f: Awaited<ReturnType<typeof fixture>>) => [{ ...f.candidate, pluginId: undefined, pluginRoot: undefined }],
+		(f: Awaited<ReturnType<typeof fixture>>) => [f.candidate, f.candidate],
+		(f: Awaited<ReturnType<typeof fixture>>) => [
+			{ ...f.candidate, declaration: { ...f.candidate.declaration, disabled_tools: ["restricted"] } },
+		],
+	]) {
+		const f = await fixture();
+		await f.defer();
+		const record = f.host.list()[0];
+		f.discover(change(f));
+		await expect(f.host.start(record.requestId, f.context())).rejects.toThrow();
+		expect(f.starts()).toBe(0);
+	}
+});
+test("changed or removed host declarations invalidate a pending request", async () => {
+	for (const remove of [false, true]) {
+		const f = await fixture();
+		await f.defer();
+		const record = f.host.list()[0],
+			file = path.join(f.root, "dfsc.host.json");
+		if (remove) await rm(file);
+		else await writeFile(file, JSON.stringify({ consumer: { server: "other" } }));
+		await expect(f.host.start(record.requestId, f.context())).rejects.toThrow();
+		expect(f.starts()).toBe(0);
+	}
+});
+test("shutdown settlement waits for an in-flight deferred connection to finish cleanup", async () => {
+	const f = await fixture();
+	let release!: () => void, reached!: () => void;
+	const gate = new Promise<void>((done) => {
+		release = done;
+	});
+	const ready = new Promise<void>((done) => {
+		reached = done;
+	});
+	await f.host.defer(
+		f.candidate,
+		async () => {
+			reached();
+			await gate;
+			return false;
+		},
+		() => false,
+	);
+	const starting = f.host.start(f.host.list()[0].requestId, f.context());
+	const rejected = expect(starting).rejects.toThrow();
+	await ready;
+	f.controller.abort();
+	let settled = false;
+	const stopping = f.host.settled().then(() => {
+		settled = true;
+	});
+	await Promise.resolve();
+	expect(settled).toBe(false);
+	release();
+	await stopping;
+	await rejected;
+});
+test("session changes, abort and replacement invalidate all old private records", async () => {
+	const f = await fixture();
+	await f.defer();
+	const record = f.host.list()[0];
+	f.session("different-session");
+	await expect(f.host.inspect(record.requestId)).rejects.toThrow();
+	f.controller.abort();
+	expect(f.host.list()).toEqual([]);
+	await expect(desktopPluginHostCommand(f.owner, { action: "list" })).rejects.toThrow();
+});
+test("failed startup consumes a record without echoing private launch context", async () => {
+	const f = await fixture();
+	await f.host.defer(
+		f.candidate,
+		async (context) => {
+			throw new Error(context);
+		},
+		() => false,
+	);
+	const record = f.host.list()[0];
+	await expect(f.host.start(record.requestId, f.context())).rejects.toThrow(
+		"Desktop plugin host launch is unavailable or stale",
+	);
+	await expect(f.host.start(record.requestId, f.context())).rejects.toThrow();
+	expect(f.host.list()[0].phase).toBe("failed");
+});
