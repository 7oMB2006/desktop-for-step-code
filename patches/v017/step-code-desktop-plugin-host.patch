diff --git a/packages/coding-agent/src/step/desktop-plugin-host.ts b/packages/coding-agent/src/step/desktop-plugin-host.ts
new file mode 100644
index 0000000..82149ab
--- /dev/null
+++ b/packages/coding-agent/src/step/desktop-plugin-host.ts
@@ -0,0 +1,215 @@
+import { createHash, randomUUID } from "node:crypto";
+import { lstat, readFile } from "node:fs/promises";
+import path from "node:path";
+
+export interface DesktopHostCandidate {
+	pluginId?: string;
+	pluginRoot?: string;
+	name: string;
+	hostConflict?: boolean;
+	declaration: {
+		command?: string;
+		args?: string[];
+		cwd?: string;
+		env?: Record<string, string>;
+		url?: string;
+		enabled_tools?: string[];
+		disabled_tools?: string[];
+	};
+}
+interface RecordView {
+	requestId: string;
+	sessionId: string;
+	pluginId: string;
+	consumer: string;
+	root: string;
+	executionHash: string;
+	declarationHash: string;
+	conflict: boolean;
+	phase: "pending" | "starting" | "connected" | "failed";
+}
+interface LaunchRecord {
+	view: RecordView;
+	candidate: DesktopHostCandidate;
+	start(context: string): Promise<boolean>;
+	connected(): boolean;
+	policy: string;
+}
+const sessions = new WeakMap<object, DesktopPluginHost>();
+const fail = (): never => {
+	throw new Error("Desktop plugin host launch is unavailable or stale");
+};
+async function sidecar(root: string) {
+	const file = path.join(root, "dfsc.host.json"),
+		info = await lstat(file);
+	if (!info.isFile() || info.isSymbolicLink() || info.size > 65536) return fail();
+	const bytes = await readFile(file);
+	if (bytes.length > 65536) return fail();
+	return { value: JSON.parse(bytes.toString("utf8")), hash: createHash("sha256").update(bytes).digest("hex") };
+}
+
+export function desktopHostExecutionHash(candidate: DesktopHostCandidate): string {
+	const declaration = candidate.declaration;
+	return createHash("sha256")
+		.update(
+			JSON.stringify([
+				declaration.command,
+				declaration.args ?? [],
+				declaration.cwd,
+				Object.entries(declaration.env ?? {}).sort(([a], [b]) => a.localeCompare(b)),
+			]),
+		)
+		.digest("hex");
+}
+
+// Records originate in native discovery, not plugin tools, PID lookups or public IPC.
+export class DesktopPluginHost {
+	private records = new Map<string, LaunchRecord>();
+	private starting = new Set<Promise<{ started: boolean }>>();
+	private owner: object;
+	private sessionId: () => string;
+	private discover: () => Promise<DesktopHostCandidate[]>;
+	private signal: AbortSignal;
+	constructor(
+		owner: object,
+		sessionId: () => string,
+		discover: () => Promise<DesktopHostCandidate[]>,
+		signal: AbortSignal,
+	) {
+		this.owner = owner;
+		this.sessionId = sessionId;
+		this.discover = discover;
+		this.signal = signal;
+		sessions.set(owner, this);
+		signal.addEventListener(
+			"abort",
+			() => {
+				this.records.clear();
+				if (sessions.get(owner) === this) sessions.delete(owner);
+			},
+			{ once: true },
+		);
+	}
+	async defer(candidate: DesktopHostCandidate, start: LaunchRecord["start"], connected: () => boolean) {
+		if (!candidate.pluginId || !candidate.pluginRoot || this.signal.aborted) return false;
+		let declaration: Awaited<ReturnType<typeof sidecar>>;
+		try {
+			declaration = await sidecar(candidate.pluginRoot);
+		} catch (error) {
+			if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+			return true;
+		}
+		const consumer = declaration.value?.consumer?.server;
+		if (typeof consumer !== "string") return true;
+		if (candidate.name !== `${candidate.pluginId}__${consumer}`) return false;
+		if (this.records.size >= 64 || this.signal.aborted) return true;
+		const view: RecordView = {
+			requestId: randomUUID(),
+			sessionId: this.sessionId(),
+			pluginId: candidate.pluginId,
+			consumer,
+			root: path.resolve(candidate.pluginRoot),
+			executionHash: desktopHostExecutionHash(candidate),
+			declarationHash: declaration.hash,
+			conflict: candidate.hostConflict === true || Boolean(candidate.declaration.url),
+			phase: "pending",
+		};
+		this.records.set(view.requestId, {
+			view,
+			candidate,
+			start,
+			connected,
+			policy: JSON.stringify(candidate.declaration),
+		});
+		return true;
+	}
+	private current(requestId: unknown) {
+		const record = typeof requestId === "string" ? this.records.get(requestId) : undefined;
+		if (
+			!record ||
+			this.signal.aborted ||
+			sessions.get(this.owner) !== this ||
+			record.view.sessionId !== this.sessionId()
+		)
+			return fail();
+		return record;
+	}
+	async inspect(requestId: unknown) {
+		const record = this.current(requestId);
+		const fresh = (await this.discover()).filter((item) => item.name === record.candidate.name);
+		if (
+			fresh.length !== 1 ||
+			fresh[0].hostConflict ||
+			fresh[0].declaration.url ||
+			fresh[0].pluginId !== record.view.pluginId ||
+			fresh[0].pluginRoot !== record.candidate.pluginRoot ||
+			desktopHostExecutionHash(fresh[0]) !== record.view.executionHash ||
+			JSON.stringify(fresh[0].declaration) !== record.policy ||
+			(await sidecar(record.view.root)).hash !== record.view.declarationHash ||
+			record.view.conflict ||
+			record.view.phase === "failed" ||
+			(record.view.phase === "connected" && !record.connected())
+		)
+			return fail();
+		this.current(requestId);
+		return { ...record.view };
+	}
+	list() {
+		if (this.signal.aborted || sessions.get(this.owner) !== this) return [];
+		return [...this.records.values()].map((record) => ({ ...record.view }));
+	}
+	start(requestId: unknown, context: unknown) {
+		const operation = this.launch(requestId, context).finally(() => this.starting.delete(operation));
+		this.starting.add(operation);
+		return operation;
+	}
+	async settled() {
+		await Promise.allSettled([...this.starting]);
+	}
+	private async launch(requestId: unknown, context: unknown) {
+		const record = this.current(requestId);
+		await this.inspect(requestId);
+		if (record.view.phase !== "pending" || typeof context !== "string" || Buffer.byteLength(context) > 16384)
+			return fail();
+		let launch: { version?: string; mode?: string; pluginId?: string; consumer?: string; sessionId?: string };
+		try {
+			launch = JSON.parse(context);
+		} catch {
+			return fail();
+		}
+		if (
+			launch?.version !== "dfsc-launch-v1" ||
+			!["follow", "independent"].includes(launch.mode ?? "") ||
+			launch.pluginId !== record.view.pluginId ||
+			launch.consumer !== record.view.consumer ||
+			launch.sessionId !== record.view.sessionId
+		)
+			return fail();
+		record.view.phase = "starting";
+		try {
+			if (!(await record.start(context))) return fail();
+			this.current(requestId);
+			record.view.phase = "connected";
+			return { started: true };
+		} catch {
+			record.view.phase = "failed";
+			return fail();
+		}
+	}
+}
+
+export async function desktopPluginHostCommand(
+	owner: object,
+	input: {
+		action: string;
+		requestId?: string;
+		context?: string;
+	},
+) {
+	const host = sessions.get(owner);
+	if (!host) return fail();
+	if (input.action === "list") return { records: host.list() };
+	if (input.action === "inspect") return host.inspect(input.requestId);
+	if (input.action === "start") return host.start(input.requestId, input.context);
+	return fail();
+}
