+	if (server.transport instanceof StreamableHTTPClientTransport) {
+		const timeout = new AbortController();
+		try {
+			await Promise.race([
+				server.transport.terminateSession(),
+				delay(2000, undefined, { signal: timeout.signal, ref: false }).then(() => {
+					throw new Error("MCP session termination timed out");
+				}),
+			]);
