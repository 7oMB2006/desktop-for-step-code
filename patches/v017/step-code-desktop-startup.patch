+} from "../src/step/desktop-startup.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const harnesses: Harness[] = [];
+afterEach(() => {
+	for (const harness of harnesses.splice(0)) harness.cleanup();
+	vi.unstubAllEnvs();
+});
+function fixture(owner = {}) {
+	vi.stubEnv("DFSC_RUNTIME_ID", randomUUID());
+	vi.stubEnv("DFSC_CONFIGURATION_REVISION", randomUUID());
+	const startup = new DesktopStartup(owner, "target");
+	let launches = 0;
+	startup.defer(() => {
+		launches++;
+	});
+	const identity = () => ({ sessionId: "target", startupEpoch: startup.snapshot().startupEpoch });
+	return { startup, owner, identity, launches: () => launches };
+}
+
+test("the opt-in is RPC-only and requires explicit runtime identity", () => {
+	vi.stubEnv("DFSC_ASYNC_STARTUP_V1", "1");
+	vi.stubEnv("DFSC_RUNTIME_ID", "");
+	expect(desktopStartupEnabled("rpc")).toBe(false);
+	fixture();
+	expect(desktopStartupEnabled("rpc")).toBe(true);
+	expect(desktopStartupEnabled("print")).toBe(false);
+	expect(desktopStartupEnabled("tui")).toBe(false);
+});
+test("target binding is explicit and starts discovery once; model readiness is independent", () => {
+	const f = fixture();
+	expect(f.launches()).toBe(0);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	expect(() => f.startup.bind({ ...f.identity(), sessionId: "other" })).toThrow("STARTUP_NOT_READY");
+	f.startup.bind(f.identity());
+	f.startup.bind(f.identity());
+	expect(f.launches()).toBe(1);
+	f.startup.discovered([]);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	f.startup.modelReady(f.identity());
+	expect(() => acquireExecutionAdmission(f.owner).verify()).not.toThrow();
+	expect(f.startup.snapshot().toolsSettledAt).toBeTypeOf("number");
