+import { createHash, randomUUID } from "node:crypto";
+import {
+	type ExecutionAdmission,
+	ExecutionNotReadyError,
+	registerExecutionAdmission,
+} from "../core/execution-admission.ts";
+
+export interface DesktopToolStartup {
+	name: string;
+	status: "connecting" | "pending" | "connected" | "failed" | "disabled";
+	toolCount: number;
+	hosted?: boolean;
+	cleanupConfirmed?: boolean;
+	startedAt: number;
+	settledAt?: number;
+}
+export interface DesktopStartupState {
+	protocol: 1;
+	runtimeId: string;
+	sessionId: string;
+	startupEpoch: string;
+	configurationRevision: string;
+	catalogRevision: number;
+	targetBound: boolean;
+	modelReady: boolean;
+	discovery: "waiting" | "discovering" | "ready" | "failed";
+	cleanupConfirmed: boolean;
+	tools: DesktopToolStartup[];
+	coreReadyAt: number;
+	sessionBoundAt?: number;
+	modelReadyAt?: number;
+	pluginHostsSettledAt?: number;
+	toolsSettledAt?: number;
+	firstPromptAcceptedAt?: number;
+}
+type Submission = { digest: string; approval?: { submissionId: string; receipt: string }; consumed: boolean };
+const submissions = new AsyncLocalStorage<Submission>();
+const states = new WeakMap<object, DesktopStartup>();
+const observers = new WeakMap<object, (state: DesktopStartupState) => void>();
+const unsafeRuntimes = new Set<string>();
+
+export function desktopStartupEnabled(mode: string) {
+	return (
+		mode === "rpc" &&
+		process.env.DFSC_ASYNC_STARTUP_V1 === "1" &&
+		Boolean(process.env.DFSC_RUNTIME_ID && process.env.DFSC_CONFIGURATION_REVISION)
+	);
+}
+export function startupSubmissionDigest(type: string, payload: object) {
+	const { startupApproval: _approval, id: _id, type: _type, ...rest } = payload as Record<string, unknown>;
+	return createHash("sha256")
+		.update(JSON.stringify([type, rest]))
+		.digest("hex");
+}
+export function withStartupSubmission<T>(
+	command: { type: string; startupApproval?: Submission["approval"] },
+	action: () => T,
+): T {
+	return submissions.run(
+		{ digest: startupSubmissionDigest(command.type, command), approval: command.startupApproval, consumed: false },
+		action,
+	);
+}
+export function observeDesktopStartup(owner: object, observer: (state: DesktopStartupState) => void) {
+	observers.set(owner, observer);
+	return () => {
+		if (observers.get(owner) === observer) observers.delete(owner);
+	};
+}
+export function getDesktopStartup(owner: object) {
+	return states.get(owner);
+}
+export function prepareDesktopStartup(owner: object, mode: string) {
+	if (!desktopStartupEnabled(mode)) return;
+	registerExecutionAdmission(owner, () => {
+		throw new ExecutionNotReadyError();
+	});
+}
+
+export class DesktopStartup {
+	private state: DesktopStartupState;
+	private launch?: () => void;
+	private release: () => void;
+	private disposed = false;
+	private owner: object;
+	private discoveryTimer?: ReturnType<typeof setTimeout>;
+	private cancel?: () => void;
+	private receipts = new Map<string, { submissionId: string; digest: string; revision: number; expires: number }>();
+	private submissionIds = new Map<string, { digest: string; receipt: string }>();
+	constructor(owner: object, sessionId: string, cancel?: () => void) {
+		this.owner = owner;
+		this.cancel = cancel;
+		states.get(owner)?.dispose();
+		this.state = {
+			protocol: 1,
+			runtimeId: process.env.DFSC_RUNTIME_ID!,
+			sessionId,
+			startupEpoch: randomUUID(),
+			configurationRevision: process.env.DFSC_CONFIGURATION_REVISION!,
+			catalogRevision: 0,
+			targetBound: false,
+			modelReady: false,
+			discovery: "waiting",
+			cleanupConfirmed: !unsafeRuntimes.has(process.env.DFSC_RUNTIME_ID!),
+			tools: [],
+			coreReadyAt: Date.now(),
+		};
+		states.set(owner, this);
+		this.release = registerExecutionAdmission(owner, (consume) => this.admit(consume));
+		this.publish();
+	}
+	snapshot(): DesktopStartupState {
+		return {
+			...this.state,
+			cleanupConfirmed: this.state.cleanupConfirmed && !unsafeRuntimes.has(this.state.runtimeId),
+			tools: this.state.tools.map((tool) => ({ ...tool })),
+		};
+	}
+	private publish(catalog = false) {
+		if (this.disposed) return;
+		if (catalog) {
+			this.state.catalogRevision++;
+			this.receipts.clear();
+		}
+		const discovered = this.state.discovery === "ready";
+		const settled = (tool: DesktopToolStartup) => !["connecting", "pending"].includes(tool.status);
+		this.state.pluginHostsSettledAt =
+			discovered && this.state.tools.filter((tool) => tool.hosted).every(settled)
+				? (this.state.pluginHostsSettledAt ?? Date.now())
+				: undefined;
+		this.state.toolsSettledAt =
+			discovered && this.state.tools.every(settled) ? (this.state.toolsSettledAt ?? Date.now()) : undefined;
+		try {
+			observers.get(this.owner)?.(this.snapshot());
+		} catch {}
+	}
+	defer(launch: () => void) {
+		this.launch = launch;
+	}
+	bind(input: { sessionId?: string; startupEpoch?: string }) {
+		if (this.disposed || input.sessionId !== this.state.sessionId || input.startupEpoch !== this.state.startupEpoch)
+			throw new ExecutionNotReadyError();
+		if (!this.state.targetBound) {
+			this.state.targetBound = true;
+			this.state.sessionBoundAt = Date.now();
+			this.state.discovery = "discovering";
+			this.discoveryTimer = setTimeout(() => {
+				this.discoveryFailed();
+				this.cancel?.();
+			}, 60000).unref();
+			this.publish();
+			const launch = this.launch;
+			this.launch = undefined;
+			if (!launch) this.discoveryFailed();
+			else launch();
+		}
+		return this.snapshot();
+	}
+	modelReady(input: { sessionId?: string; startupEpoch?: string }) {
+		if (
+			input.sessionId !== this.state.sessionId ||
+			input.startupEpoch !== this.state.startupEpoch ||
+			!this.state.targetBound ||
+			this.disposed
+		)
+			throw new ExecutionNotReadyError();
+		this.state.modelReady = true;
+		this.state.modelReadyAt ??= Date.now();
+		this.publish();
+		return this.snapshot();
+	}
+	discovered(tools: DesktopToolStartup[]) {
+		if (tools.some((tool) => tool.cleanupConfirmed === false)) this.markUnsafe();
+		if (this.disposed || this.state.discovery === "failed") return;
+		clearTimeout(this.discoveryTimer);
+		if (tools.length > 512 || new Set(tools.map((tool) => tool.name)).size !== tools.length) {
+			this.discoveryFailed();
+			return;
+		}
+		this.state.discovery = "ready";
+		this.state.tools = tools.map((tool) => ({ ...tool }));
+		this.publish(true);
+	}
+	discoveryFailed() {
+		clearTimeout(this.discoveryTimer);
+		this.state.discovery = "failed";
+		this.publish(true);
+	}
+	update(name: string, value: Partial<DesktopToolStartup>) {
+		if (value.cleanupConfirmed === false) this.markUnsafe();
+		const tool = this.state.tools.find((item) => item.name === name);
+		if (!tool || this.disposed) return;
+		const cleanupUnconfirmed = tool.cleanupConfirmed === false || value.cleanupConfirmed === false;
+		Object.assign(tool, value);
+		if (cleanupUnconfirmed) tool.cleanupConfirmed = false;
+		if (cleanupUnconfirmed) this.markUnsafe();
+		if (!["connecting", "pending"].includes(tool.status)) tool.settledAt = Date.now();
+		this.publish(true);
+	}
+	private markUnsafe() {
+		unsafeRuntimes.add(this.state.runtimeId);
+		this.state.cleanupConfirmed = false;
+	}
+	private available() {
+		return (
+			!this.disposed &&
+			states.get(this.owner) === this &&
+			this.state.targetBound &&
+			this.state.modelReady &&
+			this.state.discovery === "ready" &&
+			this.state.cleanupConfirmed &&
+			!unsafeRuntimes.has(this.state.runtimeId) &&
+			this.state.toolsSettledAt !== undefined &&
+			this.state.tools.every((tool) => tool.cleanupConfirmed !== false)
+		);
+	}
+	private missing() {
+		return this.state.tools
+			.filter((tool) => tool.status === "failed")
+			.map((tool) => tool.name)
+			.sort();
+	}
+	authorize(input: {
+		sessionId?: string;
+		startupEpoch?: string;
+		catalogRevision?: number;
+		submissionId?: string;
+		digest?: string;
+		missing?: string[];
+	}) {
+		if (
+			!this.available() ||
+			input.sessionId !== this.state.sessionId ||
+			input.startupEpoch !== this.state.startupEpoch ||
+			input.catalogRevision !== this.state.catalogRevision ||
+			!this.missing().length ||
+			JSON.stringify(input.missing) !== JSON.stringify(this.missing()) ||
+			!/^[a-f0-9-]{36}$/u.test(input.submissionId ?? "") ||
+			!/^[a-f0-9]{64}$/u.test(input.digest ?? "")
+		)
+			throw new ExecutionNotReadyError();
+		for (const [key, receipt] of this.receipts) if (receipt.expires <= Date.now()) this.receipts.delete(key);
+		const previous = this.submissionIds.get(input.submissionId!);
+		if (previous) {
+			const receipt = this.receipts.get(previous.receipt);
+			if (previous.digest !== input.digest || !receipt) throw new ExecutionNotReadyError();
+			return { submissionId: input.submissionId!, receipt: previous.receipt };
+		}
+		if (this.receipts.size >= 16) throw new ExecutionNotReadyError();
+		if (this.submissionIds.size >= 512) throw new ExecutionNotReadyError();
+		const receipt = randomUUID();
+		this.receipts.set(receipt, {
+			submissionId: input.submissionId!,
+			digest: input.digest!,
+			revision: this.state.catalogRevision,
+			expires: Date.now() + 120000,
+		});
+		this.submissionIds.set(input.submissionId!, { digest: input.digest!, receipt });
+		return { submissionId: input.submissionId!, receipt };
+	}
+	private admit(consume: boolean): ExecutionAdmission {
+		if (!this.available()) throw new ExecutionNotReadyError();
+		const revision = this.state.catalogRevision;
+		const request = submissions.getStore();
+		if (this.missing().length || request?.approval) {
+			const receipt = request?.approval && this.receipts.get(request.approval.receipt);
+			if (
+				!request ||
+				request.consumed ||
+				!receipt ||
+				receipt.expires <= Date.now() ||
+				receipt.submissionId !== request.approval!.submissionId ||
+				receipt.digest !== request.digest ||
+				receipt.revision !== revision
+			)
+				throw new ExecutionNotReadyError();
+			if (consume) {
+				this.receipts.delete(request.approval!.receipt);
+				request.consumed = true;
+			}
+		}
+		return {
+			verify: () => {
+				if (!this.available() || revision !== this.state.catalogRevision) throw new ExecutionNotReadyError();
+				if (consume && this.state.firstPromptAcceptedAt === undefined) {
+					this.state.firstPromptAcceptedAt = Date.now();
+					this.publish();
+				}
+			},
+		};
+	}
+	dispose() {
+		if (this.disposed) return;
+		this.disposed = true;
+		clearTimeout(this.discoveryTimer);
+		this.receipts.clear();
+		this.submissionIds.clear();
+		this.launch = undefined;
+		// Retain a rejecting gate until a new session installs its own policy.
+		registerExecutionAdmission(this.owner, () => {
+			throw new ExecutionNotReadyError();
+		});
+		if (states.get(this.owner) === this) states.delete(this.owner);
+		this.release();
+	}
+}
