diff --git a/packages/coding-agent/src/core/execution-admission.ts b/packages/coding-agent/src/core/execution-admission.ts
new file mode 100644
index 0000000..e0e6861
--- /dev/null
+++ b/packages/coding-agent/src/core/execution-admission.ts
@@ -0,0 +1,24 @@
+export interface ExecutionAdmission {
+	verify(): void;
+}
+
+const checks = new WeakMap<object, (consume: boolean) => ExecutionAdmission>();
+
+/** Product policies can gate execution without changing storage or the Agent loop. */
+export function registerExecutionAdmission(owner: object, check: (consume: boolean) => ExecutionAdmission) {
+	checks.set(owner, check);
+	return () => {
+		if (checks.get(owner) === check) checks.delete(owner);
+	};
+}
+
+export function acquireExecutionAdmission(owner: object, consume = true): ExecutionAdmission {
+	return checks.get(owner)?.(consume) ?? { verify() {} };
+}
+
+export class ExecutionNotReadyError extends Error {
+	constructor() {
+		super("STARTUP_NOT_READY: session, model and tools must be ready before accepting execution");
+		this.name = "ExecutionNotReadyError";
+	}
+}
