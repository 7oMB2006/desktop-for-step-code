+++ b/packages/coding-agent/src/features/subagent/desktop-role-models.ts
@@ -0,0 +1,30 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import type { ThinkingLevel } from "@step-harness/agent-core";
+
+export type DesktopSubagentModel = { provider: string; id: string; effort: ThinkingLevel };
+export type DesktopSubagentModelEvidence = DesktopSubagentModel & { source: "role" | "inherited" | "definition" | "explicit" };
+
+export async function readDesktopRoleModels(): Promise<ReadonlyMap<string, DesktopSubagentModel> | undefined> {
+	if (process.env.STEP_CLIENT !== "desktop-for-step-code" || !process.env.STEPCODE_STORAGE_ROOT_DIR) return undefined;
+	const roles = new Map<string, DesktopSubagentModel>();
+	const data = await readFile(join(process.env.STEPCODE_STORAGE_ROOT_DIR, "desktop-subagent-models.json"), "utf8").catch(
+		(error: NodeJS.ErrnoException) => {
+			if (error.code !== "ENOENT") throw error;
+			return '{"version":1,"roles":{}}';
+		},
+	);
+	const record = JSON.parse(data);
+	if (record?.version !== 1 || !record.roles || typeof record.roles !== "object" || Array.isArray(record.roles))
+		throw new Error("Invalid Desktop subagent role settings");
+	for (const [role, value] of Object.entries(record.roles)) {
+		const row = value as DesktopSubagentModel | null;
+		if (!["general", "explore", "review", "planner"].includes(role) ||
+			!row || typeof row.provider !== "string" || !row.provider || row.provider.length > 200 || /[\/\s:]/.test(row.provider) ||
+			typeof row.id !== "string" || !row.id || row.id.length > 300 || /[\r\n\0]/.test(row.id) ||
+			!["off", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"].includes(row.effort))
+			throw new Error("Invalid Desktop subagent role model");
+		roles.set(role, { provider: row.provider, id: row.id, effort: row.effort });
+	}
+	return roles;
+}
