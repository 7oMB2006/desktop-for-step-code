diff --git a/packages/coding-agent/test/desktop-ultra.test.ts b/packages/coding-agent/test/desktop-ultra.test.ts
new file mode 100644
index 0000000..3ab5941
--- /dev/null
+++ b/packages/coding-agent/test/desktop-ultra.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it } from "vitest";
+import { clampThinkingLevel, getSupportedThinkingLevels, type Model } from "@step-harness/providers";
+import { clampReasoning } from "../../providers/src/api/simple-options.ts";
+import { isValidThinkingLevel } from "../src/cli/args.ts";
+
+const model: Model<"openai-responses"> = {
+	id: "fixture",
+	name: "Fixture",
+	provider: "desktop-custom-fixture",
+	api: "openai-responses",
+	baseUrl: "http://127.0.0.1:1/v1",
+	reasoning: true,
+	input: ["text"],
+	contextWindow: 128000,
+	maxTokens: 16384,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+};
+
+describe("Desktop Ultra effort", () => {
+	it("is a distinct accepted level, not the UltraCode execution mode", () => {
+		expect(isValidThinkingLevel("ultra")).toBe(true);
+		expect(isValidThinkingLevel("ultracode")).toBe(false);
+	});
+	it("requires an explicit model mapping and orders Ultra above max", () => {
+		expect(getSupportedThinkingLevels(model)).not.toContain("ultra");
+		const supported = { ...model, thinkingLevelMap: { max: "max", ultra: "ultra" } };
+		expect(getSupportedThinkingLevels(supported).slice(-2)).toEqual(["max", "ultra"]);
+		expect(clampThinkingLevel(supported, "ultra")).toBe("ultra");
+		expect(getSupportedThinkingLevels({ ...supported, reasoning: false })).toEqual(["off"]);
+	});
+	it("clamps away from Ultra after switching to an unsupported model", () => {
+		expect(clampThinkingLevel({ ...model, thinkingLevelMap: { max: "max" } }, "ultra")).toBe("max");
+		expect(getSupportedThinkingLevels({ ...model, thinkingLevelMap: { ultra: null } })).not.toContain("ultra");
+	});
+	it("does not invent a numeric Ultra thinking budget", () => {
+		expect(clampReasoning("ultra")).toBe("high");
+	});
+});
