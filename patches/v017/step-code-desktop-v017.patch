+test("Desktop dismissal preserves the native pending decision across questions and restore", async () => {
+	const cwd = makeWorkspace();
+	const h = createHarness({ cwd, flags: { "desktop-plan-review": true } });
+	createStepPlanExtension()(h.api);
+	const context = h.ctx({ mode: "rpc", planReviewSurface: true });
+	await h.commands.get("plan")!.handler("on", context);
+	const file = getPlanFilePath("sess-1", cwd);
+	mkdirSync(path.dirname(file), { recursive: true });
+	writeFileSync(file, "Proposal still awaiting consent");
+	const hash = createHash("sha256").update("Proposal still awaiting consent", "utf8").digest("hex");
+	const result = await h.tools.get("exit_plan_mode")!.execute("exit", {}, undefined, undefined, context);
+	expect(result.details).toMatchObject({ outcome: "dismissed", planModeExited: false });
+	await h.emit({ type: "before_agent_start", prompt: "A question is not approval" }, context);
+	await h.emit({ type: "message_start", fromUser: true }, context);
+	expect(pendingProposalOf({ sessionManager: h.session })).toMatchObject({ pendingProposalHash: hash });
+	const restored = createHarness({
+		cwd,
+		entries: [{ type: "custom", customType: "step-plan", data: lastPlanEntry(h) }],
+	});
+	createStepPlanExtension()(restored.api);
+	const restoredContext = restored.ctx({ mode: "rpc", planReviewSurface: true });
+	await restored.emit({ type: "session_start", reason: "resume" }, restoredContext);
+	expect(pendingProposalOf({ sessionManager: restored.session })).toMatchObject({ pendingProposalHash: hash });
+	expect(restored.statuses.get("plan-mode")).toBe("Planning (user)");
+	await restored.commands.get("plan")!.handler("off", restoredContext);
+	expect(lastPlanEntry(restored).pendingProposalHash).toBeUndefined();
+	expect(lastPlanEntry(restored).enabled).toBe(false);
+});
