+test.each([
+	["background_done", "completed"],
+	["background_failed", "failed"],
+] as const)("terminal lane notification %s publishes child IDs but not transcript paths", async (event, status) => {
+	const { pi, sent } = fakePi();
+	const sessionId = "subagent-fixture";
+	const sessionFile = String.raw`C:\fixture\profiles\private\child-transcript.jsonl`;
+	const target = lane({
+		status,
+		details: {
+			mode: "single",
+			agentScope: "user",
+			userAgentsDir: "/nonexistent-unused",
+			projectAgentsDir: null,
+			results: [record({ status, sessionId, sessionFile })],
+		},
+	});
+	notifyLaneEvent(pi, target, event, await buildLaneFinalDetail(target, "/nonexistent-unused"));
+	expect(sent).toHaveLength(1);
+	const [notification] = sent;
+	expect(notification.content).toContain(`- task 1 (general): ${sessionId}`);
+	expect(notification.details?.detail).toContain(`- task 1 (general): ${sessionId}`);
+	expect(notification.content).not.toContain("child-transcript.jsonl");
+	expect(notification.details?.detail).not.toContain("child-transcript.jsonl");
+	const projected = convertToLlm([
+		{ ...notification, role: "custom", customType: "agent-notification", display: true, timestamp: 0 },
+	]);
+	expect(projected).toMatchObject([
+		{ role: "user", content: [{ type: "text", text: expect.stringContaining(sessionId) }] },
+	]);
+	expect(JSON.stringify(projected)).not.toContain("child-transcript.jsonl");
+	expect(target.details.results[0]?.sessionFile).toBe(sessionFile);
+});
