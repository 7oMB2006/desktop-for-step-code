+import { randomUUID } from "node:crypto";
+import { join } from "node:path";
+import { fauxAssistantMessage } from "@step-harness/providers";
+import { afterEach, expect, test, vi } from "vitest";
+import { acquireExecutionAdmission } from "../src/core/execution-admission.ts";
+import { createStepExtension } from "../src/features/step.ts";
+import { createStepPlanExtension, getStepPlanState } from "../src/features/step-plan.ts";
+import {
+	DesktopStartup,
+	desktopStartupEnabled,
+	prepareDesktopStartup,
+	startupSubmissionDigest,
+	withStartupSubmission,
+} from "../src/step/desktop-startup.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const harnesses: Harness[] = [];
+afterEach(() => {
+	for (const harness of harnesses.splice(0)) harness.cleanup();
+	vi.unstubAllEnvs();
+});
+function fixture(owner = {}) {
+	vi.stubEnv("DFSC_RUNTIME_ID", randomUUID());
+	vi.stubEnv("DFSC_CONFIGURATION_REVISION", randomUUID());
+	const startup = new DesktopStartup(owner, "target");
+	let launches = 0;
+	startup.defer(() => {
+		launches++;
+	});
+	const identity = () => ({ sessionId: "target", startupEpoch: startup.snapshot().startupEpoch });
+	return { startup, owner, identity, launches: () => launches };
+}
+
+test("the opt-in is RPC-only and requires explicit runtime identity", () => {
+	vi.stubEnv("DFSC_ASYNC_STARTUP_V1", "1");
+	vi.stubEnv("DFSC_RUNTIME_ID", "");
+	expect(desktopStartupEnabled("rpc")).toBe(false);
+	fixture();
+	expect(desktopStartupEnabled("rpc")).toBe(true);
+	expect(desktopStartupEnabled("print")).toBe(false);
+	expect(desktopStartupEnabled("tui")).toBe(false);
+});
+test("target binding is explicit and starts discovery once; model readiness is independent", () => {
+	const f = fixture();
+	expect(f.launches()).toBe(0);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	expect(() => f.startup.bind({ ...f.identity(), sessionId: "other" })).toThrow("STARTUP_NOT_READY");
+	f.startup.bind(f.identity());
+	f.startup.bind(f.identity());
+	expect(f.launches()).toBe(1);
+	f.startup.discovered([]);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	f.startup.modelReady(f.identity());
+	expect(() => acquireExecutionAdmission(f.owner).verify()).not.toThrow();
+	expect(f.startup.snapshot().toolsSettledAt).toBeTypeOf("number");
+});
+test("connecting, unknown discovery and unconfirmed cleanup are never bypassable", () => {
+	const f = fixture();
+	f.startup.bind(f.identity());
+	f.startup.modelReady(f.identity());
+	f.startup.discovered([{ name: "slow", status: "connecting", toolCount: 0, startedAt: Date.now() }]);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	f.startup.update("slow", { status: "failed", cleanupConfirmed: false });
+	expect(() => f.startup.authorize({ ...f.identity() })).toThrow("STARTUP_NOT_READY");
+	f.startup.update("slow", { status: "failed", cleanupConfirmed: true });
+	expect(f.startup.snapshot().tools[0].cleanupConfirmed).toBe(false);
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	f.startup.discoveryFailed();
+	expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+});
+test("optional failures need no receipt; explicit legacy receipts remain payload-bound and non-replayable", () => {
+	const f = fixture();
+	f.startup.bind(f.identity());
+	f.startup.modelReady(f.identity());
+	f.startup.discovered([{ name: "missing", status: "failed", toolCount: 0, startedAt: Date.now() }]);
+	expect(() => acquireExecutionAdmission(f.owner).verify()).not.toThrow();
+	const command = { type: "prompt", message: "one task" };
+	const receipt = f.startup.authorize({
+		...f.identity(),
+		catalogRevision: f.startup.snapshot().catalogRevision,
+		submissionId: randomUUID(),
+		digest: startupSubmissionDigest(command.type, command),
+		missing: ["missing"],
+	});
+	const differentCommand = { ...command, message: "different", startupApproval: receipt };
+	expect(() => withStartupSubmission(differentCommand, () => acquireExecutionAdmission(f.owner))).toThrow(
+		"STARTUP_NOT_READY",
+	);
+	withStartupSubmission({ ...command, startupApproval: receipt }, () => {
+		acquireExecutionAdmission(f.owner, false).verify();
+		const admission = acquireExecutionAdmission(f.owner);
+		admission.verify();
+		admission.verify();
+		expect(() => acquireExecutionAdmission(f.owner)).toThrow("STARTUP_NOT_READY");
+	});
+	expect(() =>
+		withStartupSubmission({ ...command, startupApproval: receipt }, () => acquireExecutionAdmission(f.owner)),
+	).toThrow("STARTUP_NOT_READY");
+});
+test("optional failures allow repeated normal, steer and follow-up admissions without issuing receipts", () => {
+	const f = fixture();
+	f.startup.bind(f.identity());
+	f.startup.modelReady(f.identity());
+	f.startup.discovered([{ name: "optional", status: "failed", toolCount: 0, startedAt: Date.now() }]);
+	for (let i = 0; i < 600; i++) {
+		for (const streamingBehavior of [undefined, "steer", "followUp"]) {
+			withStartupSubmission({ type: "prompt", ...{ message: `task ${i}`, streamingBehavior } }, () =>
+				acquireExecutionAdmission(f.owner).verify(),
+			);
+		}
+	}
+	expect(f.startup.snapshot().firstPromptAcceptedAt).toBeTypeOf("number");
+	expect(f.startup.snapshot().tools[0].status).toBe("failed");
+	f.startup.dispose();
+});
+test("actual AgentSession keeps its loop, steering and follow-up usable after optional MCP failure", async () => {
+	const harness = await createHarness();
+	harnesses.push(harness);
+	const f = fixture(harness.sessionManager);
+	f.startup.bind(f.identity());
+	f.startup.modelReady(f.identity());
+	f.startup.discovered([{ name: "optional", status: "failed", toolCount: 0, startedAt: Date.now() }]);
+	let release!: () => void;
+	const pending = new Promise<void>((resolve) => {
+		release = resolve;
+	});
+	harness.setResponses([
+		async () => {
+			await pending;
+			return fauxAssistantMessage("first");
+		},
+		fauxAssistantMessage("steered"),
+		fauxAssistantMessage("follow-up"),
+	]);
+	const run = harness.session.prompt("normal");
+	try {
