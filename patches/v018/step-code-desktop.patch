+					);
+				}
+			} else if (r.type === "token_usage_record") {
+				const usage = Object.fromEntries(
+					Object.entries(record(p.usage ?? p)).filter(
+						([, n]) => typeof n === "number" && Number.isSafeInteger(n) && n >= 0,
+					),
+				);
