+import * as childProcess from "node:child_process";
+import { once } from "node:events";
+import { setTimeout as delay } from "node:timers/promises";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { killProcessTree, terminateProcessTreeGracefully } from "../src/utils/process-tree.ts";
+
+vi.mock("node:child_process", async (importOriginal) => {
+	const actual = await importOriginal<typeof childProcess>();
+	return { ...actual, spawnSync: vi.fn(actual.spawnSync) };
+});
+
+const started = "Sun Oct  4 18:00:00 2026";
+describe("Darwin shell descendant ownership", () => {
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.mocked(childProcess.spawnSync).mockReset();
+		vi.restoreAllMocks();
+	});
+
+	function fixture({ reused = false, unavailable = false } = {}) {
+		vi.spyOn(process, "platform", "get").mockReturnValue("darwin");
+		const kill = vi.spyOn(process, "kill").mockReturnValue(true);
+		const ps = vi.mocked(childProcess.spawnSync).mockImplementation(
+			(_executable, args) =>
+				({
+					status: unavailable ? 1 : 0,
+					signal: null,
+					pid: 0,
+					output: [],
+					stderr: "",
+					stdout:
+						args?.[0] === "-p"
+							? `${args[1]} 1 ${reused && args[1] === "102" ? started.replace("18:00", "19:00") : started}\n`
+							: `101 1 ${started}\n103 102 ${started}\n102 101 ${started}\n199 1 ${started}\n`,
+				}) as ReturnType<typeof childProcess.spawnSync>,
+		);
+		return { kill, ps };
+	}
+
+	it("targets detached descendants in reverse order and excludes unrelated jobs", () => {
+		const { kill, ps } = fixture();
+		killProcessTree(101);
+		expect(kill.mock.calls).toEqual([
+			[-101, "SIGKILL"],
+			[103, "SIGKILL"],
+			[102, "SIGKILL"],
+		]);
+		expect(ps).toHaveBeenNthCalledWith(
+			1,
+			"/bin/ps",
+			["-axo", "pid=,ppid=,lstart="],
+			expect.objectContaining({ timeout: 2000, env: expect.objectContaining({ LC_ALL: "C" }) }),
+		);
+	});
+
+	it("does not signal a PID with a changed birth timestamp", () => {
+		const { kill } = fixture({ reused: true });
+		killProcessTree(101);
+		expect(kill.mock.calls).toEqual([
+			[-101, "SIGKILL"],
+			[103, "SIGKILL"],
+		]);
+	});
+
+	it("retains group cleanup when process discovery is unavailable", () => {
+		const { kill } = fixture({ unavailable: true });
+		killProcessTree(101);
+		expect(kill.mock.calls).toEqual([[-101, "SIGKILL"]]);
+	});
+
+	it("reuses the initial descendant snapshot if the parent exited between TERM and KILL", async () => {
+		vi.useFakeTimers();
+		const { kill, ps } = fixture();
+		const stop = terminateProcessTreeGracefully(101, 50, { keepAlive: true });
+		expect(kill.mock.calls).toEqual([
+			[-101, "SIGTERM"],
+			[103, "SIGTERM"],
+			[102, "SIGTERM"],
+		]);
+		// The identity probes now report PPID 1. A fresh traversal would lose both children.
+		await vi.advanceTimersByTimeAsync(50);
+		await stop.settled;
+		expect(kill.mock.calls.slice(3)).toEqual([
+			[-101, "SIGKILL"],
+			[103, "SIGKILL"],
+			[102, "SIGKILL"],
+		]);
+		expect(ps.mock.calls.filter(([, args]) => args?.[0] === "-axo")).toHaveLength(1);
+	});
+});
+
+function psField(pid: number, field: "stat" | "lstart"): string | undefined {
+	const result = childProcess.spawnSync("/bin/ps", ["-p", String(pid), "-o", `${field}=`], {
+		encoding: "utf8",
+		timeout: 2000,
+		env: { ...process.env, LC_ALL: "C" },
+	});
+	return result.status === 0 ? result.stdout.trim() || undefined : undefined;
+}
+
+function alive(pid: number): boolean {
+	const status = psField(pid, "stat");
+	return Boolean(status && !status.startsWith("Z"));
+}
+
+describe.skipIf(process.platform !== "darwin")("real Darwin shell cancellation", () => {
+	it("kills a nested detached process while another command survives", async () => {
+		const childScript = "setInterval(() => {}, 1000)";
+		const parentScript = `
+const { spawn } = require("node:child_process");
+const child = spawn(process.execPath, ["-e", ${JSON.stringify(childScript)}], { detached: true, stdio: "ignore" });
+console.log(child.pid);
+setInterval(() => {}, 1000);
+`;
+		const parent = childProcess.spawn(process.execPath, ["-e", parentScript], {
+			detached: true,
+			stdio: ["ignore", "pipe", "ignore"],
+		});
+		const other = childProcess.spawn(process.execPath, ["-e", childScript], { detached: true, stdio: "ignore" });
+		let descendant: number | undefined;
+		let descendantStarted: string | undefined;
+		try {
+			const [output] = await once(parent.stdout!, "data", { signal: AbortSignal.timeout(5000) });
+			descendant = Number(String(output).trim());
+			expect(descendant).toBeGreaterThan(0);
+			descendantStarted = psField(descendant, "lstart");
+			expect(descendantStarted).toBeDefined();
+			expect(alive(descendant)).toBe(true);
+			killProcessTree(parent.pid!);
+			for (let attempt = 0; attempt < 100 && (alive(parent.pid!) || alive(descendant)); attempt++) await delay(20);
+			expect(alive(parent.pid!)).toBe(false);
+			expect(alive(descendant)).toBe(false);
+			expect(alive(other.pid!)).toBe(true);
+		} finally {
+			parent.kill("SIGKILL");
+			other.kill("SIGKILL");
+			if (descendant && descendantStarted && psField(descendant, "lstart") === descendantStarted) {
+				try {
+					process.kill(descendant, "SIGKILL");
+				} catch {
+					// The fixture process exited.
+				}
+			}
+		}
+	}, 15_000);
+});
