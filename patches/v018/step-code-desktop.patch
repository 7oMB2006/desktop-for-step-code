+	for (const line of input.split(/\r?\n/u)) {
+		if (!line.trim()) continue;
+		let value: unknown;
+		try {
+			value = JSON.parse(line);
+		} catch {
+			throw new SessionImportError("Invalid JSONL snapshot; wait for the source to finish writing");
+		}
+		await visit(value, 0);
+		lines.push(JSON.stringify(value));
+	}
