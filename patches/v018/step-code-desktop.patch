+		const runWorkflow = () => workflow.runScript(script, null);
+		const leading = Promise.resolve(first === "workflow" ? runWorkflow() : runSubagents());
+		operations.push(leading);
+		await waitFor(() => starts.length === 2);
+		const trailing = Promise.resolve(first === "workflow" ? runSubagents(controller.signal) : runWorkflow());
+		operations.push(trailing);
+		void trailing.catch(() => {});
+		await waitFor(() => (first === "workflow" ? subagentQueued : workflowQueued));
