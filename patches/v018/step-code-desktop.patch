diff --git a/packages/coding-agent/src/modes/rpc/desktop-btw.ts b/packages/coding-agent/src/modes/rpc/desktop-btw.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0d9656fb61e93fecee1a602d17b30d5d668017f5
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/desktop-btw.ts
@@ -0,0 +1,130 @@
+import type { AssistantMessage, Message } from "@step-harness/providers";
+import type { AgentSession } from "../../core/agent-session.ts";
+import { convertToLlm } from "../../core/messages.ts";
+
+const reminder = [
+	"<system-reminder>This is a side question from the user. Answer it directly in a single response.",
+	"Tools are unavailable. Do not continue, plan, or edit anything for the main task.</system-reminder>",
+].join("\n");
+const identity = (value: unknown): value is string => typeof value === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(value);
+const text = (message: AssistantMessage) =>
+	message.content.filter((block) => block.type === "text").map((block) => block.text).join("");
+
+/** Only a bare invocation envelope, not a fenced/quoted example or prose discussing tools. */
+export function btwToolProtocol(value: string): boolean {
+	return /^(?:<tool_call>\s*<function=[\w.:-]+>|<function=[\w.:-]+>\s*<parameter=|<function_calls>\s*<invoke\b)/i.test(value.trimStart());
+}
+
+/** Keep only a complete prefix: an in-flight tool call must not reach a second request unpaired. */
+export function btwContext(messages: Message[]): Message[] {
+	for (let i = 0; i < messages.length; i++) {
+		const message = messages[i];
+		if (message.role !== "assistant") continue;
+		const calls = message.content.filter((block) => block.type === "toolCall");
+		if (!calls.length) continue;
+		const results = new Set<string>();
+		let next = i + 1;
+		while (messages[next]?.role === "toolResult") {
+			results.add((messages[next] as { toolCallId: string }).toolCallId);
+			next++;
+		}
+		if (calls.some((call) => !results.has(call.id))) return messages.slice(0, i);
+	}
+	return messages;
+}
+
+/** A model-only fork, never an agent, session entry, or main-turn event. */
+export class DesktopBtw {
+	private readonly session: () => AgentSession;
+	private readonly output: (event: object) => void;
+	private scope?: string;
+	private history: { question: string; message: AssistantMessage }[] = [];
+	private active?: { requestId: string; scopeId: string; controller: AbortController; settled: Promise<void> };
+	constructor(session: () => AgentSession, output: (event: object) => void) {
+		this.session = session;
+		this.output = output;
+	}
+
+	start(input: { requestId: string; scopeId: string; sessionId: string; question: string }): void {
+		const session = this.session();
+		if (!identity(input.requestId) || !identity(input.scopeId) || input.sessionId !== session.sessionManager.getSessionId()
+			|| typeof input.question !== "string" || !input.question.trim() || input.question.length > 8000)
+			throw new Error("Invalid side question");
+		if (this.active) throw new Error("A side question is already running");
+		if (session.isCompacting || !session.model) throw new Error("Side question is unavailable");
+		if (this.scope !== input.scopeId) { this.scope = input.scopeId; this.history = []; }
+		const question = input.question.trim(), model = session.model;
+		const context = structuredClone({
+			systemPrompt: `${session.systemPrompt}\n\n${reminder}`,
+			messages: [
+				...btwContext(convertToLlm(session.agent.state.messages)),
+				...this.history.flatMap(({ question, message }): Message[] => [
+					{ role: "user", content: [{ type: "text", text: question }], timestamp: message.timestamp }, message,
+				]),
+				{ role: "user" as const, content: [{ type: "text" as const, text: `${reminder}\n\n${question}` }], timestamp: Date.now() },
+			],
+		});
+		const active = { requestId: input.requestId, scopeId: input.scopeId, controller: new AbortController(), settled: Promise.resolve() };
+		this.active = active;
+		const emit = (value: object) => this.output({ type: "desktop_btw", requestId: input.requestId,
+			scopeId: input.scopeId, sessionId: input.sessionId, ...value });
+		emit({ kind: "start", model: { id: model.id, provider: model.provider, name: model.name } });
+		active.settled = (async () => {
+			const timer = setTimeout(() => active.controller.abort(), 120_000);
+			let usage: AssistantMessage["usage"] | undefined;
+			try {
+				// Same native auth/provider resolution as upstream /btw; never fall back to another route.
+				const stream = session.modelRuntime.stream(model, context, { signal: active.controller.signal, maxTokens: 2048 });
+				let chars = 0;
+				for await (const event of stream) {
+					if (event.type === "text_delta" && !active.controller.signal.aborted) {
+						chars += event.delta.length;
+						if (chars > 64_000) { active.controller.abort(); break; }
+						emit({ kind: "delta", text: event.delta });
+					}
+				}
+				const message = await stream.result();
+				usage = message.usage;
+				if (active.controller.signal.aborted || message.stopReason === "aborted") emit({ kind: "cancelled", usage });
+				else if (message.stopReason === "toolUse" || message.content.some((block) => block.type === "toolCall")
+					|| btwToolProtocol(text(message)))
+					emit({ kind: "error", reason: "tools_unavailable", usage });
+				else if (message.stopReason === "error"
+					|| !text(message).trim() || text(message).length > 64_000)
+					emit({ kind: "error", usage });
+				else {
+					this.history = [...this.history, { question, message }].slice(-20);
+					while (this.history.length > 1 && this.history.reduce((size, item) => size + item.question.length + text(item.message).length, 0) > 64_000)
+						this.history.shift();
+					emit({ kind: "done", text: text(message), usage, truncated: message.stopReason === "length" });
+				}
+			} catch {
+				// Provider errors can contain credentials or request bodies; only a stable outcome crosses RPC.
+				emit({ kind: active.controller.signal.aborted ? "cancelled" : "error", usage });
+			} finally {
+				clearTimeout(timer);
+				if (this.active === active) this.active = undefined;
+			}
+		})();
+	}
+
+	async cancel(requestId: string, scopeId: string): Promise<void> {
+		const active = this.active;
+		if (!active || active.requestId !== requestId || active.scopeId !== scopeId) return;
+		active.controller.abort();
+		await active.settled;
+	}
+
+	clear(scopeId: string): void {
+		if (this.scope !== scopeId) return;
+		if (this.active) throw new Error("Cancel the side question before clearing history");
+		this.history = [];
+		this.scope = undefined;
+	}
+
+	reset(): void {
+		this.active?.controller.abort();
+		this.history = [];
+		this.scope = undefined;
+	}
+}
diff --git a/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts b/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts
new file mode 100644
index 0000000000000000000000000000000000000000..072dc370724cfc0d2ac9e81b35063ac04885f2a9
--- /dev/null
+++ b/packages/coding-agent/src/modes/rpc/desktop-completion-review.ts
@@ -0,0 +1,161 @@
+import { randomUUID } from "node:crypto";
+import type { AgentSession, AgentSessionEvent, PromptOptions } from "../../core/agent-session.ts";
+import { completionCheckFeedback } from "../completion-check.ts";
+
+type Status = "pending" | "reviewing" | "ended" | "failed" | "cancelled" | "skipped";
+type Reason = "input" | "cancelled" | "rebound" | "failure" | "denied" | "approval" | "mode" | "intercepted" | "no_final_text" | "persistence";
+interface Review {
+	version: 1;
+	id: string;
+	sessionId: string;
+	status: Status;
+	sent: boolean;
+	reason?: Reason;
+}
+interface Run {
+	session: AgentSession;
+	state: Review;
+	reason?: Reason;
+	delivered: boolean;
+	finalText: boolean;
+	expected?: string;
+}
+const reasonPriority: Record<Reason, number> = {
+	input: 0, mode: 1, intercepted: 1, no_final_text: 1,
+	failure: 2, denied: 2, approval: 2, cancelled: 3, rebound: 4, persistence: 5,
+};
+function mark(run: Run, reason: Reason): void {
+	if (!run.reason || reasonPriority[reason] > reasonPriority[run.reason]) run.reason = reason;
+}
+function outcome(reason?: Reason): Status {
+	return reason === "cancelled" || reason === "rebound" ? "cancelled"
+		: reason === "failure" || reason === "no_final_text" || reason === "persistence" ? "failed"
+		: reason ? "skipped" : "ended";
+}
+
+/** Owns one explicit RPC task, never an agent_end callback or a recurring reviewer. */
+export class DesktopCompletionReview {
+	private active?: Run;
+	private readonly session: () => AgentSession;
+	private readonly output: (event: object) => void;
+	private readonly eligible: () => boolean;
+	constructor(
+		session: () => AgentSession,
+		output: (event: object) => void,
+		eligible: () => boolean,
+	) { this.session = session; this.output = output; this.eligible = eligible; }
+
+	get running(): boolean { return this.active !== undefined; }
+	skip(reason: "input" | "cancelled" | "rebound"): void {
+		if (this.active && (reason !== "input" || this.active.state.status === "pending"))
+			mark(this.active, reason);
+	}
+
+	async prompt(message: string, options: PromptOptions): Promise<void> {
+		const session = this.session();
+		if (this.active || session.isStreaming || session.isCompacting || session.pendingMessageCount)
+			throw new Error("Completion review requires a new idle task.");
+		if (!this.eligible() || message.trimStart().startsWith("/") || /^(?:ultracode|ultraloop):/i.test(message.trimStart()))
+			throw new Error("Completion review is only available for ordinary main tasks.");
+		const run: Run = { session, state: { version: 1, id: randomUUID(), sessionId: session.sessionId,
+			status: "pending", sent: false }, delivered: false, finalText: false };
+		const cwd = session.sessionManager.getCwd(), model = session.model, thinking = session.thinkingLevel;
+		this.active = run;
+		let accepted = false, finished = false;
+		const persist = () => {
+			try { session.sessionManager.appendCustomEntry("desktop-completion-review", run.state); }
+			catch (error) { mark(run, "persistence"); throw error; }
+		};
+		const output = () => this.output({ type: "desktop_completion_review", review: run.state,
+			completed: !run.reason && run.finalText && run.state.status === "ended" });
+		const publish = (status: Status, reason?: Reason) => {
+			run.state = { ...run.state, status, ...(reason ? { reason } : {}) };
+			persist();
+			output();
+		};
+		const finish = async (status: Status, reason?: Reason) => {
+			if (finished) return;
+			finished = true;
+			run.state = { ...run.state, status, ...(reason ? { reason } : {}) };
+			try {
+				persist();
+				if (accepted && this.session() === session)
+					await session.sendCustomMessage({ customType: "desktop-completion-review-result", display: true,
+						content: `Completion self-review: ${status}${reason ? ` (${reason})` : ""}.`,
+						details: { ...run.state } }, { triggerTurn: false });
+			} catch (error) {
+				mark(run, "persistence");
+				run.state = { ...run.state, status: "failed", reason: "persistence" };
+				// A broken history store must not strand Desktop's task ownership.
+				try { persist(); } catch { /* The terminal event remains authoritative for this live task. */ }
+				output();
+				throw error;
+			}
+			output();
+		};
+		const unsubscribe = session.subscribe((event: AgentSessionEvent) => {
+			if (event.type === "message_start") {
+				if (run.state.status === "pending" && event.message.role === "user") run.delivered = true;
+				if (event.message.role === "custom" && event.message.customType === "desktop-completion-review-input"
+					&& (event.message.details as { reviewId?: string } | undefined)?.reviewId === run.state.id
+					&& (typeof event.message.content === "string" ? event.message.content
+						: event.message.content.filter(part => part.type === "text").map(part => part.text).join("\n")) === run.expected)
+					run.state.sent = true;
+			}
+			if (event.type === "message_end" && event.message.role === "assistant") {
+				const message = event.message;
+				if (message.stopReason === "error") mark(run, "failure");
+				if (message.stopReason === "aborted") mark(run, "cancelled");
+				run.finalText = !["toolUse", "error", "aborted"].includes(message.stopReason)
+					&& !message.content.some(part => part.type === "toolCall")
+					&& message.content.some(part => part.type === "text" && part.text.trim().length > 0);
+			}
+			if (event.type === "tool_execution_end") {
+				const result = event.result as { terminate?: unknown; details?: { outcome?: unknown } } | undefined;
+				if (event.isError && result?.terminate === true) mark(run, "denied");
+				if (!event.isError && event.toolName === "exit_plan_mode" && result?.details?.outcome === "external_approval_required")
+					mark(run, "approval");
+			}
+		});
+		try {
+			// Reserve the task before extension input handlers can themselves run an agent.
+			publish("pending");
+			await session.prompt(message, { ...options, preflightResult: success => {
+				if (success && (run.reason === "cancelled" || run.reason === "rebound"))
+					throw new Error("Task cancelled before delivery.");
+				if (success) accepted = true;
+				options.preflightResult?.(success);
+			} });
+			if (this.session() !== session || session.sessionManager.getCwd() !== cwd) mark(run, "rebound");
+			if (!this.eligible() || session.model !== model || session.thinkingLevel !== thinking) mark(run, "mode");
+			if (!run.delivered) mark(run, "intercepted");
+			if (session.pendingMessageCount) mark(run, "input");
+			if (!run.reason) {
+				publish("reviewing");
+				const feedback = completionCheckFeedback(undefined, run.finalText, true);
+				run.expected = feedback;
+				run.finalText = false;
+				await session.prompt(feedback, {
+					source: "extension", expandPromptTemplates: false,
+					preflightResult: success => {
+						if (success && run.reason) throw new Error("Completion review was cancelled before delivery.");
+					},
+					customMessage: { customType: "desktop-completion-review-input", display: true,
+						details: { version: 1, reviewId: run.state.id, source: "completion-review" } },
+				});
+				if (!run.state.sent) mark(run, "intercepted");
+				else if (!run.finalText) mark(run, "no_final_text");
+			}
+			const reason = run.reason;
+			await finish(outcome(reason), reason);
+		} catch (error) {
+			mark(run, "failure");
+			const reason = run.reason ?? "failure";
+			await finish(outcome(reason), reason);
+			throw error;
+		} finally {
+			unsubscribe();
+			if (this.active === run) this.active = undefined;
+		}
+	}
+}
